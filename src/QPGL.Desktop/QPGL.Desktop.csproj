<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="NPOI" Version="2.7.1" />
    <!-- 图片导出（GDI+ 表格重绘，移植 qp11 销售明细 ImagePreviewWindow 方案） -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QPGL.Domain\QPGL.Domain.csproj" />
    <ProjectReference Include="..\QPGL.Infrastructure\QPGL.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 打印配置模板：安装包 onlyifdoesntexist 保护，已有用户配置不被覆盖 -->
    <None Update="print.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>QP12</AssemblyName>
    <Version>0.0.91</Version>
    <AssemblyVersion>0.0.91.0</AssemblyVersion>
    <FileVersion>0.0.91.0</FileVersion>
    <InformationalVersion>0.0.91</InformationalVersion>
    <Product>QP12</Product>
    <ApplicationIcon>..\..\Ico\QP12.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 窗口标题栏/任务栏图标（MainWindow/LoginWindow pack URI 引用） -->
  <ItemGroup>
    <Resource Include="..\..\Ico\QP12.ico" Link="QP12.ico"/>
  </ItemGroup>

</Project>
