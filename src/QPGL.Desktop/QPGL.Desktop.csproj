<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="NPOI" Version="2.7.1" />
    <!-- 图片导出（GDI+ 表格重绘，移植 qp11 销售明细 ImagePreviewWindow 方案） -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QPGL.Domain\QPGL.Domain.csproj" />
    <ProjectReference Include="..\QPGL.Infrastructure\QPGL.Infrastructure.csproj" />
    <!-- Web 端进程内托管（工作台启动/停止）：引用 QPGL.Api 同一套管线 -->
    <ProjectReference Include="..\QPGL.Api\QPGL.Api.csproj" />
  </ItemGroup>

  <!-- Web 端随桌面端发布：专属配置（Jwt/端口）+ 前端页面 -->
  <ItemGroup>
    <None Include="..\QPGL.Api\appsettings.json" Link="appsettings.web.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\QPGL.Api\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 打印配置模板：安装包 onlyifdoesntexist 保护，已有用户配置不被覆盖 -->
    <None Update="print.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 发布时排除被引用 QPGL.Api 工程自带的 appsettings.json：
       它与本工程 appsettings.json 的发布相对路径重名，会触发 NETSDK1152。
       Web 端配置已通过上面的 appsettings.web.json 链接单独随包发布。 -->
  <PropertyGroup>
    <ApiAppSettingsFullPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\QPGL.Api\appsettings.json'))</ApiAppSettingsFullPath>
  </PropertyGroup>

  <Target Name="ExcludeReferencedApiAppSettings" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.FullPath)' == '$(ApiAppSettingsFullPath)' and '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json'" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>QP12</AssemblyName>
    <Version>0.0.97</Version>
    <AssemblyVersion>0.0.97.0</AssemblyVersion>
    <FileVersion>0.0.97.0</FileVersion>
    <InformationalVersion>0.0.97</InformationalVersion>
    <Product>QP12</Product>
    <ApplicationIcon>..\..\Ico\QP12.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 窗口标题栏/任务栏图标（MainWindow/LoginWindow pack URI 引用） -->
  <ItemGroup>
    <Resource Include="..\..\Ico\QP12.ico" Link="QP12.ico"/>
  </ItemGroup>

</Project>
