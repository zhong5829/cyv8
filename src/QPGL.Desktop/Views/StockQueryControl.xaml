<UserControl x:Class="QPGL.Desktop.Views.StockQueryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 警戒行颜色（2026-11-09 用户口径：低于下限红、低于上限黄；取代旧 fr_seisto 低库存蓝字） -->
        <Style x:Key="WarnRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WarnLevel}" Value="2">
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding WarnLevel}" Value="1">
                    <Setter Property="Foreground" Value="#B8860B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <!-- 查询条件条（2026-11-09 用户需求：只留 零件号/名称/车型 三框，无查询按钮；
             输入 500ms 防抖实时查询、回车立即查询；名称/车型支持拼音码，←/→ 方向键边界切换全选） -->
        <Border DockPanel.Dock="Top" Background="#F4F6F9" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="零件号" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtNno" Width="110" Text="{Binding NnoFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"
                         PreviewKeyDown="TxtCond_PreviewKeyDown" TextChanged="TxtCond_TextChanged"
                         ToolTip="缺省前缀匹配（输 pt 只查 PT 开头）；输 /pt 转包含匹配"/>
                <TextBlock Text="名称" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtNa1" Width="150" Text="{Binding Na1Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"
                         PreviewKeyDown="TxtCond_PreviewKeyDown" TextChanged="TxtCond_TextChanged"
                         ToolTip="中文包含匹配；输入拼音码同样可检索（部分匹配，如 lq→轮胎）"/>
                <TextBlock Text="车型" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtTy" Width="100" Text="{Binding TyFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"
                         PreviewKeyDown="TxtCond_PreviewKeyDown" TextChanged="TxtCond_TextChanged"
                         ToolTip="中文包含匹配；输入拼音码同样可检索（tbty0 车型库，部分匹配）"/>
                <TextBlock Text="输入即查（0.5 秒防抖），回车立即查询" Foreground="#888" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 工具条（删除行按钮已按 2026-11-09 用户需求移除；双击行/回车打开修改窗） -->
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="修改" Command="{Binding EditCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="合计" Command="{Binding TotalCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <TextBlock Text="双击行或按回车可修改" Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 库存列表（fr_istoch 列集 + fr_seisto 警戒线两列；无限下滑加载 + 双击/回车打开修改窗） -->
        <DataGrid DockPanel.Dock="Top" x:Name="Grid"
                  MouseDoubleClick="Grid_MouseDoubleClick" KeyDown="Grid_KeyDown"
                  ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column" FontSize="12"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  RowStyle="{StaticResource WarnRowStyle}">
            <DataGrid.Columns>
                <!-- 网格级 IsReadOnly=False（总开关，True 会禁用全部列编辑），除警戒两列外逐列只读 -->
                <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="零件号" Binding="{Binding Nno}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="170"/>
                <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Kcamount, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="进价(不含税)" Binding="{Binding Iprc, StringFormat=N2}" IsReadOnly="True" Width="85"/>
                <DataGridTextColumn Header="进价(含税)" Binding="{Binding Iprj, StringFormat=N2}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="售价" Binding="{Binding Oprc, StringFormat=N2}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="批发价" Binding="{Binding Oprb, StringFormat=N2}" IsReadOnly="True" Width="70"/>
                <!-- 警戒两列可就地编辑（2026-11-09 用户需求：双击进入编辑自动全选，回车提交落库 tbistojj）；
                     UpdateSourceTrigger 保持默认=提交时写回源，避免 StringFormat 打断输入中间态 -->
                <DataGridTextColumn Header="警戒上限" Binding="{Binding Amjj, StringFormat={}{0:0}}" IsReadOnly="False" Width="70"/>
                <DataGridTextColumn Header="警戒下限" Binding="{Binding Bmjj, StringFormat={}{0:0}}" IsReadOnly="False" Width="70"/>
                <DataGridTextColumn Header="货位" Binding="{Binding Posi}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="仓库" Binding="{Binding Depotno}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="串号" Binding="{Binding Cxnno}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="变动日期" Binding="{Binding Kcbhdate, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 加载状态 + 汇总（无限下滑加载，无翻页按钮） -->
        <Border DockPanel.Dock="Bottom" Padding="0,6,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{Binding LoadStatus}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="↓ 下滑到底自动加载更多" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" Foreground="#2E5C8A" Margin="0,0,14,0"><Run Text="总数量："/><Run Text="{Binding SumKcamount, Converter={StaticResource QtyInt}}"/></TextBlock>
                    <!-- 总进价金额 = Σ(iprc×数量)（不含税净成本，2026-11-08 用户确认；标题不变） -->
                    <TextBlock Text="{Binding SumIprcAmount, StringFormat=总进价金额：{0:N2}}" FontWeight="Bold" Foreground="#2E5C8A" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding SumIprjAmount, StringFormat=总批发价金额：{0:N2}}" FontWeight="Bold" Foreground="#2E5C8A" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding SumOprcAmount, StringFormat=总售价金额：{0:N2}}" FontWeight="Bold" Foreground="#2E5C8A"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
