<UserControl x:Class="QPGL.Desktop.Views.StockQueryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <!-- 查询条件条 -->
        <Border DockPanel.Dock="Top" Background="#F4F6F9" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="编码" VerticalAlignment="Center"/>
                <TextBox Width="90" Text="{Binding CpFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBlock Text="零件号" VerticalAlignment="Center"/>
                <TextBox Width="110" Text="{Binding NnoFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBlock Text="名称" VerticalAlignment="Center"/>
                <TextBox Width="120" Text="{Binding Na1Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBlock Text="车型" VerticalAlignment="Center"/>
                <TextBox Width="100" Text="{Binding TyFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBlock Text="货位" VerticalAlignment="Center"/>
                <TextBox Width="70" Text="{Binding PosiFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBlock Text="仓库" VerticalAlignment="Center"/>
                <TextBox Width="70" Text="{Binding DepotnoFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <CheckBox Content="仅看有库存" IsChecked="{Binding OnlyInStock}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="查询" Command="{Binding SearchCommand}" Padding="20,4" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- 工具条 -->
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="修改" Command="{Binding EditCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="删除行（数量=0）" Command="{Binding DeleteCommand}" Padding="14,3" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 库存列表（fr_istoch 列集） -->
        <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserSortColumns="False" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" Width="70"/>
                <DataGridTextColumn Header="零件号" Binding="{Binding Nno}" Width="120"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="170"/>
                <DataGridTextColumn Header="车型" Binding="{Binding Ty}" Width="100"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Kcamount}" Width="70"/>
                <DataGridTextColumn Header="进价" Binding="{Binding Iprc, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="进价金额" Binding="{Binding Iprj, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="售价" Binding="{Binding Oprc, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="批发价" Binding="{Binding Oprb, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="货位" Binding="{Binding Posi}" Width="60"/>
                <DataGridTextColumn Header="仓库" Binding="{Binding Depotno}" Width="60"/>
                <DataGridTextColumn Header="串号" Binding="{Binding Cxnno}" Width="110"/>
                <DataGridTextColumn Header="变动日期" Binding="{Binding Kcbhdate, StringFormat=yyyy-MM-dd}" Width="90"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页 + 汇总 -->
        <Border DockPanel.Dock="Bottom" Padding="0,6,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="上一页" Command="{Binding PrevPageCommand}" Padding="10,2" Margin="0,0,6,0"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Padding="10,2"/>
                    <TextBlock Text="{Binding Total, StringFormat=共 {0} 行}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SumKcamount, StringFormat=总数量：{0:N0}}" FontWeight="Bold" Foreground="#2E5C8A" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding SumIprjAmount, StringFormat=总进价金额：{0:N2}}" FontWeight="Bold" Foreground="#2E5C8A" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding SumOprcAmount, StringFormat=总售价金额：{0:N2}}" FontWeight="Bold" Foreground="#2E5C8A"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
