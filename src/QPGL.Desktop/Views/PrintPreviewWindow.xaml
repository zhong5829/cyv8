<Window x:Class="QPGL.Desktop.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印预览" Height="750" Width="900"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏（qp11 PrintPreviewWindow 同构）：打印机/份数/打印/关闭 -->
        <ToolBar Grid.Row="0" Margin="0,0,0,4" Band="0" BandIndex="0">
            <TextBlock Text="打印机:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="CmbPrinter" Width="200" VerticalAlignment="Center" Margin="2,0"/>
            <TextBlock Text="份数:" VerticalAlignment="Center" Margin="8,0,2,0"/>
            <TextBox x:Name="TxtCopies" Text="1" Width="35" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" TextAlignment="Center"/>
            <Separator/>
            <Button Content="打印" Width="60" Height="24" Click="Print_Click"/>
            <Button Content="关闭" Width="60" Height="24" Click="Close_Click" Margin="6,0,0,0"/>
            <Separator/>
            <TextBlock x:Name="DocInfoText" VerticalAlignment="Center" Foreground="#666" Margin="6,0,0,0"/>
        </ToolBar>

        <!-- 文档查看区（qp11 用 FlowDocumentReader；本工程票样为 FixedDocument，用 DocumentViewer 逐页缩放查看） -->
        <DocumentViewer Grid.Row="1" x:Name="Viewer"/>
    </Grid>
</Window>
