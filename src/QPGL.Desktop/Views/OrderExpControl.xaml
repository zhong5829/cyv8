<UserControl x:Class="QPGL.Desktop.Views.OrderExpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <!-- 提示条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="订货公式维护：左侧参数供公式取值，右侧公式在订货建议中引用。" Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 工具条 -->
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增公式" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFormulaCommand}" Margin="0,0,8,0"/>
                <Button Content="修改公式" Command="{Binding EditFormulaCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="删除公式" Command="{Binding DeleteFormulaCommand}" Padding="14,3" Margin="0,0,12,0"/>
                <TextBlock Text="参数值与公式名称在单元格失去焦点时保存；系统公式不可删除。" Foreground="#888" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：订货参数 -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,6">
                        <TextBlock Text="订货参数" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Params}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12"
                              CellEditEnding="ParamGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="参数编号" Binding="{Binding Paraid}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="参数名称" Binding="{Binding Parana}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="参数值" Binding="{Binding Nvalue}" Width="100"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 右：订货公式 -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,6">
                        <TextBlock Text="订货公式" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Formulas}" SelectedItem="{Binding SelectedFormula}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12"
                              CellEditEnding="FormulaGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding Expid}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="公式名称" Binding="{Binding Expna}" Width="160"/>
                            <DataGridTextColumn Header="表达式" Binding="{Binding Cexpress}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
