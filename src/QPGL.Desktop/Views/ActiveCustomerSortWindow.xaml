<Window x:Class="QPGL.Desktop.Views.ActiveCustomerSortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="粘贴客户排序" Width="460" Height="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackBrush}" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="每行一个客户名称（支持从 Excel 粘贴，取每行第一列）。确定后仅保留这里输入的客户，并按输入顺序排列。"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" Click="OnOk" Padding="18,4" Margin="0,0,8,0"/>
            <Button Content="取消" Click="OnCancel" Padding="18,4"/>
        </StackPanel>
        <!-- 全局 TextBox 样式是 VerticalContentAlignment=Center，多行输入框需显式改回 Top，否则光标停在中间 -->
        <TextBox x:Name="NamesBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="13"/>
    </DockPanel>
</Window>
