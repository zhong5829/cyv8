<Window x:Class="QPGL.Desktop.Views.SortDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="排序" Width="445" Height="280" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="136"/>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="136"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.RowSpan="1">
            <TextBlock Text="可选择的字段" Foreground="Blue" Margin="2,0,0,4"/>
            <ListBox x:Name="Lst1" Height="185" MouseDoubleClick="Lst1_DoubleClick"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="4,20,0,0">
            <Button Content="->" Height="27" Click="BtnAdd_Click" ToolTip="加入"/>
            <Button Content="&lt;-" Height="27" Margin="0,6,0,0" Click="BtnRemove_Click" ToolTip="移回"/>
            <Button Content=">>" Height="27" Margin="0,6,0,0" Click="BtnAddAll_Click" ToolTip="全部加入"/>
            <Button Content="&lt;&lt;" Height="27" Margin="0,6,0,0" Click="BtnRemoveAll_Click" ToolTip="全部移回"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="已选择排序字段" Foreground="Red" Margin="2,0,0,4"/>
            <ListBox x:Name="Lst2" Height="185" MouseDoubleClick="Lst2_DoubleClick"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="8,8,0,0">
            <RadioButton x:Name="OptAsc" Content="升序 ∧" IsChecked="True" Foreground="Blue" Margin="0,4,0,0"/>
            <RadioButton Content="降序 ∨" Foreground="Red" Margin="0,18,0,0"/>
            <Button Content="确定" Width="87" Height="27" Margin="0,60,0,0" Click="BtnOk_Click"/>
            <Button Content="取消" Width="87" Height="27" Margin="0,8,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
