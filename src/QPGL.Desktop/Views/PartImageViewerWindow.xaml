<Window x:Class="QPGL.Desktop.Views.PartImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配件图片" Width="720" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image x:Name="ImgMain" Grid.Row="0" Margin="10" Stretch="Uniform"
               MouseLeftButtonUp="ImgMain_MouseDoubleClick"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Button x:Name="BtnCopy" Content="复制图片 (Ctrl+C)" Padding="16,6" Margin="0,0,12,0"
                    Click="BtnCopy_Click"/>
            <Button Content="关闭 (Esc)" Padding="16,6" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
