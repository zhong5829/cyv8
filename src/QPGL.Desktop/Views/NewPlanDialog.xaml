<Window x:Class="QPGL.Desktop.Views.NewPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建计划单" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackBrush}">
    <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
            CornerRadius="3" Padding="16,12" Margin="8">
        <StackPanel>
            <DockPanel Margin="0,2">
                <TextBlock Text="计划单号" Width="100" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBox x:Name="CnoBox" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,2">
                <TextBlock Text="订货日期" Width="100" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <DatePicker x:Name="DatePick" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,2">
                <TextBlock Text="供应商" Width="100" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Grid>
                    <TextBox x:Name="GysBox" VerticalAlignment="Center"
                             ToolTip="支持拼音码/数字码/名称/编号联想（↑/↓ 选择，回车确认）"
                             TextChanged="GysBox_TextChanged" PreviewKeyDown="GysBox_PreviewKeyDown"/>
                    <Popup x:Name="GysPopup" PlacementTarget="{Binding ElementName=GysBox}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" MinWidth="330">
                        <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                CornerRadius="3" Margin="0,2,8,8" SnapsToDevicePixels="True">
                            <ListBox x:Name="GysList" MaxHeight="300" BorderThickness="0"
                                     MouseLeftButtonUp="GysList_MouseLeftButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Gyno}" Width="90" Foreground="#666"/>
                                            <TextBlock Text="{Binding Gyname}" Width="180"/>
                                            <TextBlock Text="{Binding Linkman}" Foreground="#888"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
            <TextBlock Text="供应商支持拼音码联想；单头信息随首行订货写入，之后可用「修改单头」调整。"
                       Foreground="#888" FontSize="11" Margin="0,6,0,4" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="确定" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True" Click="BtnOk_Click"/>
                <Button Content="取消" Width="80" Height="28" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
