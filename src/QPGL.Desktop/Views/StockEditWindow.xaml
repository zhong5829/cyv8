<Window x:Class="QPGL.Desktop.Views.StockEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="库存修改" Height="400" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource WindowBackBrush}">
    <DockPanel Margin="14">
        <!-- 库存行信息（只读） -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="厂牌：" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Cp}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="零件号："/>
                    <TextBlock Text="{Binding Nno}" Margin="0,0,14,0"/>
                    <TextBlock Text="库存 id："/>
                    <TextBlock Text="{Binding Id}"/>
                </StackPanel>
                <TextBlock Text="{Binding Na1}" Margin="0,4,0,0" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- 编辑区（fr_istoch FRM2：字段启用按权限点 B301/B302/B303/A1/'/'） -->
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/><ColumnDefinition/><ColumnDefinition Width="95"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="库存数量：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Kcamount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditQuantity}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="货位：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Posi, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="进价：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Iprc, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditPurchase}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="进价金额：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Iprj, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditPurchase}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="售价：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Oprc, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSale}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="批发价：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Oprb, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSale}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="名称：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Na1, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProperty}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="车型：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Ty, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProperty}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="单位：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProperty}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="备注：" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="保存" Command="{Binding SaveCommand}" Padding="22,5" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="取消" Click="OnCancel" Padding="22,5"/>
        </StackPanel>
    </DockPanel>
</Window>
