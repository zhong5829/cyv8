<UserControl x:Class="QPGL.Desktop.Views.SupplierPriceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <!-- 查询条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="配件编号前缀" VerticalAlignment="Center"/>
                <TextBox Width="130" Text="{Binding NnoPrefix, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="供应商" VerticalAlignment="Center"/>
                <TextBox Width="140" Text="{Binding Gyname, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Button Content="查询" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 工具条 -->
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}" Margin="0,0,8,0"/>
                <Button Content="编辑" Command="{Binding EditCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="删除" Command="{Binding DeleteCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="按供应商全删" Command="{Binding DeleteByGynameCommand}" Padding="14,3" Margin="0,0,12,0"/>
                <TextBlock Text="输入配件编号后自动带出名称；保存后更新日期自动刷新。" Foreground="#888" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="型号" Binding="{Binding Ty}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="币别" Binding="{Binding Zq, Mode=OneWay}" IsReadOnly="True" Width="70"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="外币价" Binding="{Binding Iprj, Mode=OneWay}" IsReadOnly="True" Width="80"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="供应商代码" Binding="{Binding Gyno}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="更新日期" Binding="{Binding Updadate, StringFormat=yyyy-MM-dd, Mode=OneWay}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="备注类型" Binding="{Binding Bzlx}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" IsReadOnly="True" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
