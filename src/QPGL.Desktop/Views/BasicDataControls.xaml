<UserControl x:Class="QPGL.Desktop.Views.SupplierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#F4F6F9" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="关键字（编号/名称）" VerticalAlignment="Center"/>
                <TextBox Width="160" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <Button Content="查询" Click="SearchButton_Click" Padding="20,4" FontWeight="Bold" Margin="0,0,14,0"/>
                <Button Content="新增/修改" Command="{Binding SaveCommand}" Padding="14,4" Margin="0,0,8,0"/>
                <Button Content="删除" Command="{Binding DeleteCommand}" Padding="14,4" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 无限滚动：滚动接近底部自动追加下一批，不再有翻页按钮 -->
        <DataGrid x:Name="Grid" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="12"
                  ScrollViewer.ScrollChanged="Grid_ScrollChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="供应商编号" Binding="{Binding Gyno}" Width="100"/>
                <DataGridTextColumn Header="供应商名称" Binding="{Binding Gyname}" Width="180"/>
                <DataGridTextColumn Header="联系人" Binding="{Binding Linkman}" Width="80"/>
                <DataGridTextColumn Header="电话" Binding="{Binding Tel}" Width="120"/>
                <DataGridTextColumn Header="账期" Binding="{Binding Zq}" Width="60"/>
                <DataGridTextColumn Header="税率" Binding="{Binding Sl}" Width="60"/>
                <DataGridTextColumn Header="地址" Binding="{Binding Adr}" Width="200"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Padding="2,6,0,0">
            <TextBlock Text="{Binding FooterText}" Foreground="#6B7280" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
