<Window x:Class="QPGL.Desktop.Views.EditHeadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改单头" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackBrush}">
    <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
            CornerRadius="3" Padding="16,12" Margin="8">
        <StackPanel>
            <DockPanel Margin="0,2">
                <TextBlock Text="新合同号" Width="100" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBox x:Name="CnoBox" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,2">
                <TextBlock Text="订货日期" Width="100" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <DatePicker x:Name="DatePick" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,2">
                <TextBlock Text="备注类型" Width="100" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBox x:Name="BzlxBox" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,2">
                <TextBlock Text="付款方式" Width="100" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <ComboBox x:Name="FkfsCombo" IsEditable="True" VerticalAlignment="Center"
                          DisplayMemberPath="Name" ToolTip="从下拉选择付款方式，默认挂帐"/>
            </DockPanel>
            <DockPanel Margin="0,2">
                <TextBlock Text="供应商" Width="100" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBox x:Name="GyBox" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,2">
                <TextBlock Text="直发客户" Width="100" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Grid>
                    <TextBox x:Name="GnameBox" VerticalAlignment="Center"
                             ToolTip="支持拼音码/数字码/名称/编号联想（↑/↓ 选择，回车确认）"
                             TextChanged="GnameBox_TextChanged" PreviewKeyDown="GnameBox_PreviewKeyDown"/>
                    <Popup x:Name="GnamePopup" PlacementTarget="{Binding ElementName=GnameBox}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" MinWidth="360">
                        <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                CornerRadius="3" Margin="0,2,8,8" SnapsToDevicePixels="True">
                            <ListBox x:Name="GnameList" MaxHeight="300" BorderThickness="0"
                                     MouseLeftButtonUp="GnameList_MouseLeftButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding PartNo}" Width="90" Foreground="#666"/>
                                            <TextBlock Text="{Binding PartName}" Width="180"/>
                                            <TextBlock Text="{Binding LinkMan}" Foreground="#888"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
            <TextBlock Text="直发客户支持拼音码联想；单头按合同号整体更新，明细行同步。"
                       Foreground="#888" FontSize="11" Margin="0,6,0,4" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="确定" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True" Click="BtnOk_Click"/>
                <Button Content="取消" Width="80" Height="28" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
