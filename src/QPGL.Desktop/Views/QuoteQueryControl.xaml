<UserControl x:Class="QPGL.Desktop.Views.QuoteQueryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <!-- 查询条件条 -->
        <Border DockPanel.Dock="Top" Background="#F4F6F9" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="报价单查询（类型=报价）" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="日期" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker Width="110" SelectedDate="{Binding DateFrom}" VerticalAlignment="Center"/>
                <TextBlock Text="至" VerticalAlignment="Center" Margin="4,0"/>
                <DatePicker Width="110" SelectedDate="{Binding DateTo}" VerticalAlignment="Center"/>
                <TextBlock Text="单号" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox Width="100" Text="{Binding PaperFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <TextBlock Text="客户" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox Width="130" Text="{Binding GnameFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <TextBlock Text="操作员" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox Width="80" Text="{Binding PerFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <Button Content="查询" Command="{Binding SearchCommand}"
                        Margin="16,0,0,0" Padding="20,4" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- 工具条 -->
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="明细" Command="{Binding OpenLinesCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="确认" Command="{Binding ConfirmCommand}" Padding="14,3" Margin="0,0,8,0"
                        ToolTip="row298 FRMOK：登记付款方式（guno 非空=已确认）"/>
                <Button Content="转销售" Command="{Binding ConvertToSaleCommand}" Padding="14,3" Margin="0,0,8,0"
                        ToolTip="row53 报价转销售：INSERT SELECT 新销售单（触发器扣库存），原报价单保留"/>
                <Button Content="打印" Command="{Binding PrintCommand}" Padding="14,3" Margin="0,0,8,0"
                        ToolTip="row46 语义：guno='' 未确认拦截打印"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 行级列表（tbsada type='报价'） -->
        <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserSortColumns="False" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="单号" Binding="{Binding Paper}" Width="90"/>
                <DataGridTextColumn Header="出库日期" Binding="{Binding Outdate, StringFormat=yyyy-MM-dd}" Width="85"/>
                <DataGridTextColumn Header="客户" Binding="{Binding Gname}" Width="140"/>
                <DataGridTextColumn Header="配件编码" Binding="{Binding Cp}" Width="80"/>
                <DataGridTextColumn Header="零件号" Binding="{Binding Nno}" Width="110"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="150"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Ckamount}" Width="60"/>
                <DataGridTextColumn Header="单价" Binding="{Binding Oprc, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="折后金额" Binding="{Binding Yhloprct, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="付款方式" Binding="{Binding Guno}" Width="70"/>
                <DataGridTextColumn Header="已收" Binding="{Binding Mark}" Width="45"/>
                <DataGridTextColumn Header="操作员" Binding="{Binding Per}" Width="70"/>
                <DataGridTextColumn Header="原单号" Binding="{Binding Ypaper}" Width="90"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页 + 汇总条 -->
        <Border DockPanel.Dock="Bottom" Padding="0,6,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="上一页" Command="{Binding PrevPageCommand}" Padding="10,2" Margin="0,0,6,0"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Padding="10,2"/>
                    <TextBlock Text="{Binding Total, StringFormat=共 {0} 行}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                           Text="{Binding SumAmount, StringFormat=本页折后合计：{0:N2}}" FontWeight="Bold" Foreground="#2E5C8A"/>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
