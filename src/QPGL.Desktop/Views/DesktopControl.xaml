<UserControl x:Class="QPGL.Desktop.Views.DesktopControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：快捷按钮分组（复刻 qp11 DesktopControl 布局） -->
        <StackPanel>
            <GroupBox Header="基础数据" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" Padding="8">
                <WrapPanel>
                    <Button Content="客户资料" Width="120" Margin="4" Command="{Binding OpenPartnersCommand}"/>
                    <Button Content="供应商资料" Width="120" Margin="4" Command="{Binding NotImplementedCommand}"/>
                    <Button Content="配件资料" Width="120" Margin="4" Command="{Binding NotImplementedCommand}"/>
                </WrapPanel>
            </GroupBox>
            <GroupBox Header="库存" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" Padding="8" Margin="0,8,0,0">
                <WrapPanel>
                    <Button Content="散件入库" Width="120" Margin="4" Command="{Binding NotImplementedCommand}"/>
                    <Button Content="库存查询" Width="120" Margin="4" Command="{Binding NotImplementedCommand}"/>
                    <Button Content="库存修改" Width="120" Margin="4" Command="{Binding NotImplementedCommand}"/>
                </WrapPanel>
            </GroupBox>
            <GroupBox Header="销售" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" Padding="8" Margin="0,8,0,0">
                <WrapPanel>
                    <Button Content="销售开单" Width="120" Margin="4" Command="{Binding NotImplementedCommand}"/>
                    <Button Content="销售退货" Width="120" Margin="4" Command="{Binding NotImplementedCommand}"/>
                    <Button Content="收款结算" Width="120" Margin="4" Command="{Binding NotImplementedCommand}"/>
                </WrapPanel>
            </GroupBox>
            <GroupBox Header="查询" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" Padding="8" Margin="0,8,0,0">
                <WrapPanel>
                    <Button Content="客户资料查询" Width="120" Margin="4" Command="{Binding OpenPartnersCommand}"/>
                    <Button Content="单据查询" Width="120" Margin="4" Command="{Binding NotImplementedCommand}"/>
                </WrapPanel>
            </GroupBox>
        </StackPanel>

        <!-- 右侧：KPI 卡片区（今日销售/应收/库存预警，M1 占位，二期接报表 API） -->
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <UniformGrid Columns="3">
                <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="今日销售额" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"
                                   FontFamily="{StaticResource NumFontFamily}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="今日单据数" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"
                                   FontFamily="{StaticResource NumFontFamily}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="库存预警(种)" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"
                                   FontFamily="{StaticResource NumFontFamily}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <GroupBox Header="今日配件销售排行" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                      Padding="4" Margin="0,8,0,0" Height="320">
                <TextBlock Text="统计报表接口二期交付（开发文档 §4.2）" Foreground="#999"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
