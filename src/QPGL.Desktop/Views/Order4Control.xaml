<UserControl x:Class="QPGL.Desktop.Views.Order4Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QPGL.Desktop.Views"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <local:NegativeQtyConverter x:Key="NegQty"/>
        <!-- 进货退货行（数量为负）整行红字，与销售编辑窗 HistoryRowStyle 同口径 -->
        <Style x:Key="PurchaseHistoryRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Qty, Converter={StaticResource NegQty}}" Value="True">
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <!-- 顶部工具条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="参考公式" VerticalAlignment="Center"/>
                <ComboBox Width="180" ItemsSource="{Binding Formulas}" SelectedItem="{Binding SelectedFormula}"
                          DisplayMemberPath="Expna" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="当前计划单：" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentCno}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="厂牌" VerticalAlignment="Center"/>
                <TextBox Width="70" Text="{Binding Cp, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Button Content="新建计划单" Command="{Binding NewPlanCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="修改单头" Command="{Binding EditHeadCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="删除整单" Command="{Binding DeletePlanCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="并入在途" Command="{Binding MergeTransitCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="导出表格" Command="{Binding ExportLinesCommand}" Padding="14,3" Margin="0,0,12,0"
                        ToolTip="当前计划单明细导出 xlsx：首行居中大字体供应商名，列=编码/名称/车型/订货数量"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：上=计划单列表；下=进货历史（选中明细行对应配件，2026-11-06 需求） -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.4*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="计划单列表（双击打开）" FontWeight="Bold" Margin="2,0,0,4"/>
                    <DataGrid DockPanel.Dock="Top" x:Name="PlanList" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" FontSize="12"
                              MouseDoubleClick="PlanList_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="单号" Binding="{Binding Cno}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="金额" Binding="{Binding Iprj, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="70"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="日期" Binding="{Binding Orderdate, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="备注类型" Binding="{Binding Bzlx}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="付款方式" Binding="{Binding Fkfs}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="直发客户" Binding="{Binding Gname}" IsReadOnly="True" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="进货历史（选中明细配件）" FontWeight="Bold" Margin="2,0,0,4"/>
                    <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <DataGrid ItemsSource="{Binding PurchaseHistory}" RowStyle="{StaticResource PurchaseHistoryRowStyle}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" FontSize="12" Margin="1" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="单号" Binding="{Binding Cno}" IsReadOnly="True" Width="95"/>
                                    <DataGridTextColumn Header="日期" Binding="{Binding InDate, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="85"/>
                                    <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="*"/>
                                    <DataGridTextColumn Header="数量" Binding="{Binding Qty, Mode=OneWay, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="55"
                                                        ElementStyle="{StaticResource NumCellRight}"/>
                                    <DataGridTextColumn Header="进价(不含税)" Binding="{Binding Iprj, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="90"
                                                        ElementStyle="{StaticResource NumCellRight}"/>
                                    <DataGridTextColumn Header="进价(含税)" Binding="{Binding Iprc, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="80"
                                                        ElementStyle="{StaticResource NumCellRight}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- 空态/加载/错误提示：未选中配件或该配件无进货记录时显示，避免空白区 -->
                            <TextBlock Text="{Binding PurchaseHistoryHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#888" TextWrapping="Wrap" TextAlignment="Center" Margin="12" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PurchaseHistoryHint}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- 右：当前计划单明细 -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前明细" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="选择配件" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenPickCommand}" Padding="14,3" Margin="0,0,8,0"
                                ToolTip="打开选择配件窗口（选料检索），双击/回车选定后直接订货"/>
                        <Button Content="保存" Command="{Binding SavePlanCommand}" Padding="14,3" Margin="0,0,8,0"
                                ToolTip="保存计划单（含空单）；已订明细逐行落库，关闭软件重开后双击计划单可继续订货"/>
                        <Button Content="改数量/修改行" Command="{Binding EditLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                        <Button Content="删行" Command="{Binding DeleteLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                        <Button Content="改单号/拆数量" Command="{Binding SplitMoveCommand}" Padding="14,3" Margin="0,0,8,0"/>
                        <Button Content="售价修改" Command="{Binding ChangePriceCommand}" Padding="14,3"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,6,0,0">
                    <WrapPanel>
                        <TextBlock Text="{Binding InInfo}" Foreground="#555" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding TransitInfo}" Foreground="#555" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding SupplyInfo}" Foreground="#555" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding SuggestInfo}" Foreground="{StaticResource BrandBrush}"/>
                    </WrapPanel>
                </Border>

                <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="项号" Binding="{Binding Item, Mode=OneWay}" IsReadOnly="True" Width="42"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="140"/>
                        <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="订数" Binding="{Binding Oqty, Mode=OneWay, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="库存" Binding="{Binding Kcamount, Mode=OneWay, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="进价" Binding="{Binding Iprc, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="在途" Binding="{Binding Ztqty, Mode=OneWay, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="50"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="建议" Binding="{Binding Ydqty, Mode=OneWay, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="50"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="售价" Binding="{Binding Oprc, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="产地" Binding="{Binding Dc}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True" Width="42"/>
                        <DataGridTextColumn Header="单号" Binding="{Binding Cno}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="付款方式" Binding="{Binding Fkfs}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="厂家编码" Binding="{Binding Oenno}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="直发客户" Binding="{Binding Gname}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="业务员" Binding="{Binding Per}" IsReadOnly="True" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
