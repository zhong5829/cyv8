<UserControl x:Class="QPGL.Desktop.Views.Order4Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QPGL.Desktop.ViewModels"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <vm:PartPickBrushConverter x:Key="PickBrush"/>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <!-- 顶部工具条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="参考公式" VerticalAlignment="Center"/>
                <ComboBox Width="180" ItemsSource="{Binding Formulas}" SelectedItem="{Binding SelectedFormula}"
                          DisplayMemberPath="Expna" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="当前计划单：" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentCno}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="厂牌" VerticalAlignment="Center"/>
                <TextBox Width="70" Text="{Binding Cp, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Button Content="新建计划单" Command="{Binding NewPlanCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="修改单头" Command="{Binding EditHeadCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="删除整单" Command="{Binding DeletePlanCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="并入在途" Command="{Binding MergeTransitCommand}" Padding="14,3" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：计划单列表 + 选料区 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="计划单列表（双击打开）" FontWeight="Bold" Margin="2,0,0,4"/>
                <DataGrid DockPanel.Dock="Top" x:Name="PlanList" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                          AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" FontSize="12" Height="170"
                          MouseDoubleClick="PlanList_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单号" Binding="{Binding Cno}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="金额" Binding="{Binding Iprj, Mode=OneWay}" IsReadOnly="True" Width="70"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="日期" Binding="{Binding Orderdate, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="85"/>
                        <DataGridTextColumn Header="备注类型" Binding="{Binding Bzlx}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="付款方式" Binding="{Binding Fkfs}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="直发客户" Binding="{Binding Gname}" IsReadOnly="True" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,6,0,6">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="编号" VerticalAlignment="Center"/>
                            <TextBox Width="120" Text="{Binding QNno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"
                                     ToolTip="支持 * 前缀 / / 包含"/>
                            <TextBlock Text="名称" VerticalAlignment="Center"/>
                            <TextBox Width="110" Text="{Binding QNa1, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                            <TextBlock Text="车型" VerticalAlignment="Center"/>
                            <TextBox Width="80" Text="{Binding QTy, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                            <TextBlock Text="产地" VerticalAlignment="Center"/>
                            <TextBox Width="60" Text="{Binding QDc, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                            <Button Content="检索选料" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchPartsCommand}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,5,0,0">
                            <TextBlock Text="出货起止" VerticalAlignment="Center"/>
                            <DatePicker Width="100" SelectedDate="{Binding QDate1}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <DatePicker Width="100" SelectedDate="{Binding QDate2}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="出货量" VerticalAlignment="Center"/>
                            <TextBox Width="55" Text="{Binding QNum1, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            <TextBlock Text="~" VerticalAlignment="Center"/>
                            <TextBox Width="55" Text="{Binding QNum2, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="库存区间" VerticalAlignment="Center"/>
                            <TextBox Width="55" Text="{Binding QKc1, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            <TextBlock Text="~" VerticalAlignment="Center"/>
                            <TextBox Width="55" Text="{Binding QKc2, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding PickRows}" SelectedItem="{Binding SelectedPick}"
                          AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" FontSize="12">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="{Binding Converter={StaticResource PickBrush}}"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="140"/>
                        <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="库存" Binding="{Binding Kcamount, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="外币价" Binding="{Binding Iprj, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="进价" Binding="{Binding Iprc, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="在途" Binding="{Binding Ztqty, Mode=OneWay}" IsReadOnly="True" Width="50"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="建议" Binding="{Binding Ydqty, Mode=OneWay}" IsReadOnly="True" Width="50"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="已订" Binding="{Binding Num, Mode=OneWay}" IsReadOnly="True" Width="50"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="11月均" Binding="{Binding Oamou11, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="12月均" Binding="{Binding Oamou12, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="1月均" Binding="{Binding Oamou1, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="出货" Binding="{Binding Ckamount, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="产地" Binding="{Binding Dc}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True" Width="42"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- 右：当前计划单明细 -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前明细" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="订货" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OrderLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                        <Button Content="改数量/修改行" Command="{Binding EditLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                        <Button Content="删行" Command="{Binding DeleteLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                        <Button Content="改单号/拆数量" Command="{Binding SplitMoveCommand}" Padding="14,3" Margin="0,0,8,0"/>
                        <Button Content="售价修改" Command="{Binding ChangePriceCommand}" Padding="14,3"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,6,0,0">
                    <WrapPanel>
                        <TextBlock Text="{Binding InInfo}" Foreground="#555" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding TransitInfo}" Foreground="#555" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding SupplyInfo}" Foreground="#555" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding SuggestInfo}" Foreground="{StaticResource BrandBrush}"/>
                    </WrapPanel>
                </Border>

                <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="项号" Binding="{Binding Item, Mode=OneWay}" IsReadOnly="True" Width="42"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="140"/>
                        <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="产地" Binding="{Binding Dc}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True" Width="42"/>
                        <DataGridTextColumn Header="库存" Binding="{Binding Kcamount, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="外币价" Binding="{Binding Iprj, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="进价" Binding="{Binding Iprc, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="在途" Binding="{Binding Ztqty, Mode=OneWay}" IsReadOnly="True" Width="50"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="订数" Binding="{Binding Oqty, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="建议" Binding="{Binding Ydqty, Mode=OneWay}" IsReadOnly="True" Width="50"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="售价" Binding="{Binding Oprc, Mode=OneWay}" IsReadOnly="True" Width="55"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="单号" Binding="{Binding Cno}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="付款方式" Binding="{Binding Fkfs}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="厂家编码" Binding="{Binding Oenno}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="直发客户" Binding="{Binding Gname}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="业务员" Binding="{Binding Per}" IsReadOnly="True" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
