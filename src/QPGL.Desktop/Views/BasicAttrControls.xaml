<UserControl x:Class="QPGL.Desktop.Views.BasicAttrControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,0,6">
            <TextBlock Text="基础资料（A2 零件代码 / 车型拼音码 / A7 税则号 / AA 分类码）" FontWeight="Bold"/>
        </Border>
        <TabControl>
            <TabItem x:Name="NameTab" Header="零件代码定义（A2 · tbname0）">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBox Width="160" Text="{Binding FindWhere}" ToolTip="WHERE 片段（name/code/code1）"/>
                        <Button Content="查询" Command="{Binding SearchCommand}" Margin="6,0,8,0"/>
                        <Button Content="新增" Command="{Binding NewRowCommand}" Margin="0,0,8,0"/>
                        <Button Content="保存（code=DM 全拼首字母 / code1=五笔首字母）" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                        <Button Content="删除" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                        <Button Content="从属性库提取（up_name0+getpywb）" Command="{Binding ExtractCommand}"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrandBrush}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="零件名" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="全拼码" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="别名" Binding="{Binding Name1}" Width="180"/>
                            <DataGridTextColumn Header="五笔码" Binding="{Binding Code1}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="TyTab" Header="车型拼音码（tbty0）">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBox Width="160" Text="{Binding FindWhere}" ToolTip="WHERE 片段（ty/code/code1）"/>
                        <Button Content="查询" Command="{Binding SearchCommand}" Margin="6,0,8,0"/>
                        <Button Content="新增" Command="{Binding NewRowCommand}" Margin="0,0,8,0"/>
                        <Button Content="保存（code=DM 全拼首字母 / code1=五笔首字母）" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                        <Button Content="删除" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                        <Button Content="一键初始化（建表+提取车型码）" Command="{Binding ExtractCommand}"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrandBrush}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="车型" Binding="{Binding Ty}" Width="180"/>
                            <DataGridTextColumn Header="全拼码" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="五笔码" Binding="{Binding Code1}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="ComplexTab" Header="商品税则号（A7 · tbcomplex）">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBox Width="140" Text="{Binding FindText}" ToolTip="税则号或品名包含"/>
                        <Button Content="查询" Command="{Binding FindCommand}" Margin="6,0,8,0"/>
                        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Filtered}" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="税则号" Binding="{Binding Code_ts}" Width="100"/>
                            <DataGridTextColumn Header="品名" Binding="{Binding G_name}" Width="260"/>
                            <DataGridTextColumn Header="最低税率" Binding="{Binding Low_rate, StringFormat=N4}" Width="90"/>
                            <DataGridTextColumn Header="最高税率" Binding="{Binding High_rate, StringFormat=N4}" Width="90"/>
                            <DataGridTextColumn Header="法定单位" Binding="{Binding Unit_1}" Width="70"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note_s}" Width="200"/>
                            <DataGridTemplateColumn Header="改最低税率">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="保存" Command="{Binding DataContext.SaveLowRateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="DcTab" Header="分类码定义（AA · tbdccoef）">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,6">
                        <Button Content="新增" Command="{Binding NewRowCommand}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="分类码" Binding="{Binding Dc}" Width="120"/>
                            <DataGridTemplateColumn Header="系数" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Coeffict, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="保存" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="保存" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="删除" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
