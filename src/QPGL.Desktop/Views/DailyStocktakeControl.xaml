<UserControl x:Class="QPGL.Desktop.Views.DailyStocktakeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <!-- 查询条件条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="统计日期" VerticalAlignment="Center"/>
                <DatePicker Width="110" SelectedDate="{Binding DateFrom}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBlock Text="~" VerticalAlignment="Center"/>
                <DatePicker Width="110" SelectedDate="{Binding DateTo}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <CheckBox Content="全部厂牌" IsChecked="{Binding AllCp}" VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="旧系统默认「当前厂牌」；新系统厂牌会话未接入（已知偏差），取消勾选后可输入指定厂牌"/>
                <TextBox Width="80" Text="{Binding Cp, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="仓库" VerticalAlignment="Center"/>
                <TextBox Width="70" Text="{Binding Depotno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="仓位" VerticalAlignment="Center"/>
                <TextBox Width="70" Text="{Binding Posi, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="配件编号" VerticalAlignment="Center"/>
                <TextBox Width="110" Text="{Binding NnoPrefix, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="名称" VerticalAlignment="Center"/>
                <TextBox Width="120" Text="{Binding Na1Prefix, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Button Content="查询" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" VerticalAlignment="Center"/>
                <Button Content="打印" Command="{Binding PrintCommand}" CommandParameter="{Binding ElementName=Grid}" Padding="14,3" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="    重建契约：进仓/出仓/未确认/急件未冲减口径按报表模板重建，UAT 以旧系统实测校准"
                           Foreground="#888" VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="仓位" Binding="{Binding Posi}" Width="60"/>
                <DataGridTextColumn Header="编码" Binding="{Binding Nno}" Width="115"/>
                <DataGridTextColumn Header="库存数" Binding="{Binding Kcamount}" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="入库数" Binding="{Binding JinChang}" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="出库数" Binding="{Binding ChuCang}" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="*"/>
                <DataGridTextColumn Header="车型" Binding="{Binding Ty}" Width="95"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="42"/>
                <DataGridTextColumn Header="产地" Binding="{Binding Fa}" Width="60"/>
                <DataGridTextColumn Header="库号" Binding="{Binding Depotno}" Width="50"/>
                <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" Width="60"/>
                <DataGridTextColumn Header="未确认数" Binding="{Binding Unconfirmed}" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="急件未冲减数" Binding="{Binding UrgentUnoffset}" Width="80" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="dc" Binding="{Binding Dc}" Width="50"/>
                <DataGridTextColumn Header="库存信息" Binding="{Binding KcInfo}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
