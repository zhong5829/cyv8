<UserControl x:Class="QPGL.Desktop.Views.FinYsyfLedgerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="起日" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding SDate}" Width="120" Margin="4,0,10,0"/>
                <TextBlock Text="止日" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding EDate}" Width="120" Margin="4,0,10,0"/>
                <TextBlock Text="对帐" VerticalAlignment="Center"/>
                <ComboBox SelectedIndex="{Binding IsDz}" Width="80" Margin="4,0,10,0">
                    <ComboBoxItem Content="全部"/>
                    <ComboBoxItem Content="已对帐"/>
                    <ComboBoxItem Content="未对帐"/>
                </ComboBox>
                <Button Content="查询" Command="{Binding SearchCommand}" Padding="16,3"/>
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource BrandBrush}"/>
            </StackPanel>
        </Border>
        <TabControl>
            <TabItem Header="应收（type=A）">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/><RowDefinition Height="3"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding YsHz}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="科目代码" Binding="{Binding Subcode}" Width="110"/>
                            <DataGridTextColumn Header="科目名称" Binding="{Binding Subname}" Width="*"/>
                            <DataGridTextColumn Header="期初应收" Binding="{Binding Qcys, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="本期应收" Binding="{Binding Debit, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="本期已收" Binding="{Binding Credit, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="期末余额" Binding="{Binding Ys, StringFormat=N2}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="LightGray"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Ys}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="90"/>
                            <DataGridTextColumn Header="凭证字号" Binding="{Binding Wordid}" Width="90"/>
                            <DataGridTextColumn Header="业务类型" Binding="{Binding Opertype}" Width="90"/>
                            <DataGridTextColumn Header="单号" Binding="{Binding Opercode}" Width="120"/>
                            <DataGridTextColumn Header="借方" Binding="{Binding Debit, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="贷方" Binding="{Binding Credit, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="余额" Binding="{Binding Balance, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="对帐" Binding="{Binding Fincheck}" Width="60"/>
                            <DataGridTextColumn Header="客户" Binding="{Binding Client}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="应付（type=P）">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/><RowDefinition Height="3"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding YfHz}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="科目代码" Binding="{Binding Subcode}" Width="110"/>
                            <DataGridTextColumn Header="科目名称" Binding="{Binding Subname}" Width="*"/>
                            <DataGridTextColumn Header="期初应付" Binding="{Binding Qcys, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="本期应付" Binding="{Binding Debit, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="本期已付" Binding="{Binding Credit, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="期末余额" Binding="{Binding Ys, StringFormat=N2}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="LightGray"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Yf}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="90"/>
                            <DataGridTextColumn Header="凭证字号" Binding="{Binding Wordid}" Width="90"/>
                            <DataGridTextColumn Header="业务类型" Binding="{Binding Opertype}" Width="90"/>
                            <DataGridTextColumn Header="单号" Binding="{Binding Opercode}" Width="120"/>
                            <DataGridTextColumn Header="借方" Binding="{Binding Debit, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="贷方" Binding="{Binding Credit, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="余额" Binding="{Binding Balance, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="对帐" Binding="{Binding Fincheck}" Width="60"/>
                            <DataGridTextColumn Header="供应商" Binding="{Binding Client}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="往来余额">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/><RowDefinition Height="3"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding YsyfHz}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="科目名称" Binding="{Binding Subname}" Width="*"/>
                            <DataGridTextColumn Header="期初方向" Binding="{Binding Qcdir}" Width="70"/>
                            <DataGridTextColumn Header="期初余额" Binding="{Binding Qcyue, StringFormat=N2}" Width="120"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding Dcdir}" Width="70"/>
                            <DataGridTextColumn Header="期末余额" Binding="{Binding Yue, StringFormat=N2}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="LightGray"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Ysyf}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="90"/>
                            <DataGridTextColumn Header="凭证字号" Binding="{Binding Wordid}" Width="90"/>
                            <DataGridTextColumn Header="业务类型" Binding="{Binding Opertype}" Width="90"/>
                            <DataGridTextColumn Header="单号" Binding="{Binding Opercode}" Width="120"/>
                            <DataGridTextColumn Header="借方" Binding="{Binding Debit, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="贷方" Binding="{Binding Credit, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding DcdirRaw}" Width="44"/>
                            <DataGridTextColumn Header="余额" Binding="{Binding Balance, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="科目" Binding="{Binding Subcode}" Width="100"/>
                            <DataGridTextColumn Header="往来单位" Binding="{Binding Client}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
