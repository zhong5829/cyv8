<Window x:Class="QPGL.Desktop.Views.CustomFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义字段" Width="444" Height="240" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="请选择数据源数据库" FontSize="15" Foreground="Blue"/>
        <TextBlock Grid.Column="1" Text="说明：" Foreground="Red" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <RadioButton x:Name="OptLocal" Content="1 本地数据库（当前结果集）" IsChecked="True" Margin="0,6,0,0"
                         Checked="Opt_Checked"/>
            <RadioButton x:Name="OptSys" Content="2 系统数据库" Margin="0,10,0,0" Checked="Opt_Checked"/>
            <RadioButton x:Name="OptExt" Content="3 外部数据库（CSV 文件）" Margin="0,10,0,0" Checked="Opt_Checked"/>
        </StackPanel>
        <TextBlock x:Name="TxtNote" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Foreground="#333"
                   Margin="4,8,0,0" Text="    在本地数据库的字段或增加新字段的计算"/>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="下一步 >>" Width="84" Height="25" Click="BtnNext_Click"/>
            <Button Content="退出" Width="90" Height="25" Margin="18,0,0,0" Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>
