<Window x:Class="QPGL.Desktop.Views.SkdrImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收款导入" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackBrush}" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="逐行输入 单号 / 车牌(可空) / 导入金额，确定后按客户校验并回填"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Click="OnOk" Padding="18,4" FontWeight="Bold" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="取消" Click="OnCancel" Padding="18,4" IsCancel="True"/>
        </StackPanel>
        <StackPanel x:Name="RowsPanel">
            <!-- 动态行由代码生成 -->
        </StackPanel>
    </DockPanel>
</Window>
