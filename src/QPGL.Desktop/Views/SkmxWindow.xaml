<Window x:Class="QPGL.Desktop.Views.SkmxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackBrush}" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="客户：" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Doc.Gname}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding PayLabel}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="{Binding Doc.Fkfs}" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="单号：" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Doc.Cno}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="日期：" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="{Binding Doc.Datime, StringFormat=yyyy-MM-dd}" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding PnoLabel}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Doc.Pno}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding AmountLabel}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="{Binding Doc.Amount, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="本单勾选明细：" FontWeight="Bold" Margin="0,0,0,4"/>
        <DataGrid ItemsSource="{Binding Doc.Lines}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" MinHeight="80" MaxHeight="320">
            <DataGrid.Columns>
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="70"/>
                <DataGridTextColumn Header="单据" Binding="{Binding Paper}" Width="180"/>
                <DataGridTextColumn Header="{Binding DataContext.JeHeader, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Binding="{Binding Je, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="日期" Binding="{Binding Datime, StringFormat=yyyy-MM-dd}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="关闭" IsCancel="True" Padding="18,4"/>
        </StackPanel>
    </StackPanel>
</Window>
