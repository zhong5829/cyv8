<Window x:Class="QPGL.Desktop.Views.DatabaseSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择数据库" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="检测到多个数据库连接，请选择本次使用的数据库：" Margin="0,0,0,8"/>
        <ListBox x:Name="DbList" MinHeight="140" MaxHeight="280" DisplayMemberPath="DisplayName"/>
        <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="确定" Padding="20,4" Margin="0,0,8,0" IsDefault="True" Click="OnConfirm"/>
            <Button Content="退出系统" Padding="20,4" IsCancel="True" Click="OnQuit"/>
        </WrapPanel>
    </StackPanel>
</Window>
