<UserControl x:Class="QPGL.Desktop.Views.PartnerListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 查询条件条 -->
        <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="关键字" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="KeywordBox" Width="240"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="匹配方式" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="MatchModeBox" Width="100" SelectedIndex="1">
                    <ComboBoxItem Content="精确" ToolTip="二期"/>
                    <ComboBoxItem Content="前缀匹配"/>
                    <ComboBoxItem Content="右匹配" IsEnabled="False" ToolTip="二期"/>
                    <ComboBoxItem Content="包含" IsEnabled="False" ToolTip="二期：走内存索引"/>
                </ComboBox>
                <Button Content="查询 (F3)" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SearchCommand}" Margin="16,0,0,0"/>
                <Button Content="新增" Click="OnAddPartner" Margin="14,0,0,0" Padding="14,3"/>
                <Button Content="修改" Click="OnEditPartner" Margin="8,0,0,0" Padding="14,3"/>
                <Button Content="删除" Click="OnDeletePartner" Margin="8,0,0,0" Padding="14,3"/>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 数据表格 -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3">
            <DataGrid x:Name="Grid" ItemsSource="{Binding Items}" Margin="1"
                      Sorting="Grid_Sorting">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="客户编号" Binding="{Binding PartNo}" SortMemberPath="PartNo" Width="110"/>
                    <DataGridTextColumn Header="客户名称" Binding="{Binding PartName}" SortMemberPath="PartName" Width="220"/>
                    <DataGridTextColumn Header="联系人" Binding="{Binding LinkMan}" SortMemberPath="LinkMan" Width="90"/>
                    <DataGridTextColumn Header="电话" Binding="{Binding Tel}" Width="120"/>
                    <DataGridTextColumn Header="手机" Binding="{Binding Mobile}" SortMemberPath="Mobile" Width="120"/>
                    <DataGridTextColumn Header="类别" Binding="{Binding Type1}" SortMemberPath="Type1" Width="80"/>
                    <DataGridTextColumn Header="优惠率" Binding="{Binding DiscountRate}" SortMemberPath="DiscountRate"
                                        Width="80" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="业务员" Binding="{Binding SalesMan}" Width="90"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 分页条 -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,5" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="第一页" Command="{Binding FirstPageCommand}"/>
                    <Button Content="上一页" Command="{Binding PrevPageCommand}" Margin="6,0"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}"/>
                    <Button Content="末一页" Command="{Binding LastPageCommand}" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Run Text="{Binding Total, Mode=OneWay}"/> 条 /
                    第 <Run Text="{Binding Page, Mode=OneWay}"/> /
                    <Run Text="{Binding TotalPages, Mode=OneWay}"/> 页
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                    <TextBlock Text="每页" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox Width="64" SelectedIndex="1" SelectionChanged="PageSize_SelectionChanged">
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>
                    <TextBlock Text="行" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
