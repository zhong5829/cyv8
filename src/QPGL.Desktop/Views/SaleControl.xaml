<UserControl x:Class="QPGL.Desktop.Views.SaleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:QPGL.Desktop.Views"
             Loaded="UserControl_Loaded">
    <Grid>
        <!-- ==== 模式A：开单模式（默认可见）==== -->
        <Grid x:Name="panelOrderMode" Margin="8" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 单头信息 -->
            <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnSwitchMode" Content="切换查询模式 (F3)" Click="BtnSwitchMode_Click"
                            Padding="12,4" Margin="0,0,16,0"
                            ToolTip="开单/查询双模式切换（qp11 SellControl ToggleMode 机制）"/>
                    <TextBlock Text="客户编号" VerticalAlignment="Center"/>
                    <TextBox Width="110" Text="{Binding Gno, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,16,0"/>
                    <TextBlock Text="客户名称" VerticalAlignment="Center"/>
                    <!-- 客户输入：可编辑联想下拉（旧 cmm_class FRDM 机制：拼音码 code/数字码 code1/名称/编号前缀匹配） -->
                    <Grid Margin="4,0,16,0">
                        <TextBox x:Name="GnameBox" Width="200" Text="{Binding Gname, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="GnameBox_TextChanged" PreviewKeyDown="GnameBox_PreviewKeyDown"/>
                        <Popup x:Name="CustPopup" PlacementTarget="{Binding ElementName=GnameBox}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" MinWidth="320">
                            <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="3" Margin="0,2,8,8" SnapsToDevicePixels="True">
                                <ListBox x:Name="CustList" ItemsSource="{Binding CustomerSuggestions}"
                                         MaxHeight="500" BorderThickness="0"
                                         MouseLeftButtonUp="CustList_MouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <TextBlock Text="{Binding PartNo}" Width="70" Foreground="#666"/>
                                                <TextBlock Text="{Binding PartName}" Width="170"/>
                                                <TextBlock Text="{Binding LinkMan}" Width="70" Foreground="#888"/>
                                                <TextBlock Text="{Binding Mobile}" Foreground="#888"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock Text="备注" VerticalAlignment="Center"/>
                    <TextBox Width="240" Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0"/>
                    <TextBlock Text="单号" VerticalAlignment="Center" Margin="16,0,4,0"/>
                    <TextBlock Text="{Binding LastPaper}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 配件三条件查询条（实时搜索 + 500ms 防抖；编码=内部编号包含，名称=拼音码/编码/名称/车型） -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="编码" VerticalAlignment="Center"/>
                    <TextBox x:Name="CpBox" Width="150" Margin="4,0,16,0"
                             Text="{Binding PartCp, UpdateSourceTrigger=PropertyChanged}" TextChanged="CpBox_TextChanged"
                             GotKeyboardFocus="SearchBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             ToolTip="查内部编号（包含匹配）"/>
                    <TextBlock Text="名称" VerticalAlignment="Center"/>
                    <TextBox x:Name="Na1Box" Width="200" Margin="4,0,16,0"
                             Text="{Binding PartNa1, UpdateSourceTrigger=PropertyChanged}" TextChanged="Na1Box_TextChanged"
                             GotKeyboardFocus="SearchBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             ToolTip="支持拼音码/编码/名称/车型"/>
                    <TextBlock Text="车型" VerticalAlignment="Center"/>
                    <TextBox x:Name="TyBox" Width="180" Margin="4,0,16,0"
                             Text="{Binding PartTy, UpdateSourceTrigger=PropertyChanged}" TextChanged="TyBox_TextChanged"
                             GotKeyboardFocus="SearchBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <TextBlock Text="输入即搜（0.5 秒），双击结果行加入明细；空格=开单，双击空格=显示/隐藏最近进价" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 中部：上=配件搜索结果 / 下=开单明细 -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                    <DataGrid x:Name="PartGrid" ItemsSource="{Binding PartResults}"
                              MouseDoubleClick="PartGrid_MouseDoubleClick" PreviewKeyDown="PartGrid_PreviewKeyDown" Margin="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="配件编号" Binding="{Binding Cp}" Width="100"/>
                            <DataGridTextColumn Header="内部编号" Binding="{Binding Nno}" Width="110"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="*"/>
                            <DataGridTextColumn Header="车型" Binding="{Binding Ty}" Width="90"/>
                            <DataGridTextColumn Header="货位" Binding="{Binding Posi}" Width="70"/>
                            <DataGridTextColumn Header="库存" Binding="{Binding Kcamount}" Width="70"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <!-- 2026-10-28 需求：最近一次进价默认隐藏，双击空格切换显示（PartGrid_PreviewKeyDown） -->
                            <DataGridTextColumn x:Name="LastIprcColumn" Header="最近进价" Binding="{Binding LastIprj, StringFormat=N2}"
                                                Width="80" Visibility="Collapsed"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="零售价" Binding="{Binding Oprc}" Width="80"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3">
                    <DataGrid x:Name="LineGrid" ItemsSource="{Binding Lines}" Margin="1"
                              CanUserDeleteRows="False" MouseDoubleClick="LineGrid_MouseDoubleClick"
                              PreviewKeyDown="LineGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="配件编号" Binding="{Binding Cp}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="货位" Binding="{Binding Posi}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="批次库存" Binding="{Binding BatchStock}" IsReadOnly="True" Width="70"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="70"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="单价" Binding="{Binding Price}" Width="80"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="金额" Binding="{Binding Amount, Mode=OneWay}" IsReadOnly="True" Width="90"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTemplateColumn Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Padding="0" FontSize="10"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 合计/保存条 -->
            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="10,6" Margin="0,8,0,0">
                <DockPanel>
                    <Button x:Name="BtnDistribute" Content="分货" Command="{Binding OpenDistributeCommand}" DockPanel.Dock="Right"
                            Margin="0,0,8,0" ToolTip="fr_kcfh row23 库存分货：按勾选订单生成 type='调拨' 单（guno='其它'），两种模式"/>
                    <Button x:Name="BtnConfirmDoc" Content="确认单据" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmDocCommand}" DockPanel.Dock="Right"
                            Margin="0,0,8,0" ToolTip="保存并弹出整单确认窗（row298 FRMOK：登记支付方式/优惠并写 tbsada_header）"/>
                    <Button Content="打印 F7" Command="{Binding PrintCommand}" DockPanel.Dock="Right" Margin="0,0,8,0"/>
                    <Button Content="预览" Command="{Binding PrintPreviewCommand}" DockPanel.Dock="Right" Margin="0,0,8,0"/>
                    <Button x:Name="BtnConfirm" Content="确认" Command="{Binding ConfirmDocCommand}" DockPanel.Dock="Right"
                            Margin="0,0,8,0" ToolTip="row298 FRMOK：登记付款方式/优惠并写 tbsada_header（guno 非空=已确认，报价跳过应收检查）"/>
                    <Button x:Name="BtnToQuote" Content="转报价" Command="{Binding ConvertToQuoteCommand}" DockPanel.Dock="Right"
                            Margin="0,0,8,0" ToolTip="row53 销售转报价：INSERT SELECT 新报价单 + 原销售单删除（触发器回补库存）"/>
                    <Button x:Name="BtnToPresale" Content="转预售" Command="{Binding ConvertSaleToPresaleCommand}" DockPanel.Dock="Right"
                            Margin="0,0,8,0" ToolTip="row53 销售转预售（M_PD=6）：UPDATE 原单改 type/paper/ypaper/note/outdate 换预售号，库存零变动（需 C2 权限）"/>
                    <Button x:Name="BtnToSale" Content="转销售" Command="{Binding ConvertPresaleToSaleCommand}" DockPanel.Dock="Right"
                            Margin="0,0,8,0" ToolTip="row53 预售转销售：UPDATE 原单改 5 列 + 换销售号，note='预售转销售'+日期（需 CA 权限）"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="14">
                        <Run Text="合计："/> <Run Text="{Binding TotalAmount, Mode=OneWay}" FontWeight="Bold" FontSize="16"
                            Foreground="{StaticResource BrandBrush}" FontFamily="{StaticResource NumFontFamily}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==== 模式B：查询模式（复用出库单查询，默认隐藏）==== -->
        <Grid x:Name="panelQueryMode" Visibility="Collapsed">
            <v:OutDocQueryControl x:Name="QueryControl"/>
        </Grid>
    </Grid>
</UserControl>
