<Window x:Class="QPGL.Desktop.Views.SaleLineEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="销售编辑" Width="950" Height="600"
        WindowStartupLocation="CenterOwner"
        MinWidth="800" MinHeight="500"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackBrush}"
        PreviewKeyDown="Dialog_KeyDown">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左：销售信息编辑区（qp11 SellEditDialog 同构）+ 配件信息 -->
        <Grid Grid.Column="0" Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="销售信息" Background="White"
                      BorderBrush="{StaticResource PanelBorderBrush}">
            <StackPanel Margin="8,6">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="配件编号: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPartNo" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="配件名称: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPartName" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="货位/仓库: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPosi" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="批次库存: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStock" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="备注:   " VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMemo" Grid.Column="1" Margin="0,1"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="车型/图号: " VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtTy" Grid.Column="1" Margin="0,1"
                             ToolTip="车型可编辑，随明细行保存"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="销售数量: " VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtQty" Grid.Column="1" Text="1" Margin="0,1"
                             TextChanged="QtyPrice_TextChanged"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="RbRetail" Content="零售" IsChecked="True"
                                 Margin="0,0,16,0" Checked="PriceMode_Changed"/>
                    <RadioButton x:Name="RbWholesale" Content="批发" Checked="PriceMode_Changed"/>
                </StackPanel>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="销售单价: " VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPrice" Grid.Column="1" Margin="0,1"
                             TextChanged="QtyPrice_TextChanged"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="金　　额: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAmount" Grid.Column="1" VerticalAlignment="Center"
                               FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrandBrush}"/>
                </Grid>

                <TextBlock x:Name="TxtOverStock" Visibility="Collapsed" Margin="0,0,0,4"
                           Foreground="{StaticResource WarnBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="提示: 双击右侧历史行可回填历史单价" Foreground="Gray" FontSize="11"/>
            </StackPanel>
            </GroupBox>

            <!-- 配件信息（移至左侧下方） -->
            <GroupBox Grid.Row="1" Header="配件信息" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" Margin="0,4,0,0">
                <StackPanel Margin="10,8">
                    <TextBlock x:Name="TxtIpInfo" TextWrapping="Wrap" Foreground="#555"/>
                    <TextBlock x:Name="TxtFaInfo" TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtDepotInfo" TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- 右：历史参考区（qp11 同构） -->
        <Grid Grid.Column="1" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="销售历史" Background="White"
                      BorderBrush="{StaticResource PanelBorderBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="6,6,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="筛选: " VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSellFilter" Grid.Column="1" Margin="0,1"
                                 ToolTip="按客户名称或拼音码筛选（输入即筛）"
                                 TextChanged="SellFilter_TextChanged"/>
                    </Grid>
                    <DataGrid x:Name="DgSellHistory" Margin="1"
                              MouseDoubleClick="DgSellHistory_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单号" Width="100" Binding="{Binding Paper}"/>
                        <DataGridTextColumn Header="日期" Width="90" Binding="{Binding OutDate, StringFormat=yyyy-MM-dd}"/>
                        <DataGridTextColumn Header="客户" Width="*" Binding="{Binding Gname}"/>
                        <DataGridTextColumn Header="数量" Width="60" Binding="{Binding Qty}"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="单价" Width="70" Binding="{Binding Price, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                    </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <!-- 进货历史（原配件信息区，显示历史进货价） -->
            <GroupBox Grid.Row="1" Header="进货历史" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" Margin="0,4,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="6,6,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="筛选: " VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPurchaseFilter" Grid.Column="1" Margin="0,1"
                                 ToolTip="按供应商名称或拼音码筛选（输入即筛）"
                                 TextChanged="PurchaseFilter_TextChanged"/>
                    </Grid>
                    <DataGrid x:Name="DgPurchaseHistory" Margin="1"
                              MouseDoubleClick="DgPurchaseHistory_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单号" Width="100" Binding="{Binding Cno}"/>
                        <DataGridTextColumn Header="日期" Width="90" Binding="{Binding InDate, StringFormat=yyyy-MM-dd}"/>
                        <DataGridTextColumn Header="供应商" Width="*" Binding="{Binding Gyname}"/>
                        <DataGridTextColumn Header="数量" Width="60" Binding="{Binding Qty}"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="进价(不含税)" Width="95" Binding="{Binding Iprj, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="进价(含税)" Width="85" Binding="{Binding Iprc, StringFormat=N2}"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                    </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="BtnOk" Content="确认加入明细" Width="110" Height="30" Margin="4,0"
                    Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="取消 (Esc)" Width="90" Height="30" Margin="4,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
