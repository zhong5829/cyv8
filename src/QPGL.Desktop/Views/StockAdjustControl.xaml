<UserControl x:Class="QPGL.Desktop.Views.StockAdjustControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <!-- 单据条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="新建调仓单" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewPaperCommand}" Margin="0,0,12,0"/>
                <TextBlock Text="未确认调仓单" VerticalAlignment="Center"/>
                <ComboBox Width="150" ItemsSource="{Binding OpenPapers}" SelectedItem="{Binding Paper}"
                          VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Button Content="加载" Command="{Binding LoadPaperCommand}" Margin="0,0,16,0"/>
                <Button Content="整单删除" Command="{Binding DeletePaperCommand}" Margin="0,0,16,0"/>
                <TextBlock Text="调仓单号：" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Paper}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 源批次查询 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="零件号包含" VerticalAlignment="Center"/>
                <TextBox Width="140" Text="{Binding NnoContains, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <Button Content="查询批次" Command="{Binding SearchBatchesCommand}" Margin="0,0,20,0"/>
                <TextBlock Text="数量" VerticalAlignment="Center"/>
                <TextBox Width="60" Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="目标仓库" VerticalAlignment="Center"/>
                <TextBox Width="80" Text="{Binding Depotno1, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="目标仓位" VerticalAlignment="Center"/>
                <TextBox Width="80" Text="{Binding Posi1, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Button Content="添加调仓明细" Command="{Binding AddLineCommand}" Padding="14,3"/>
            </StackPanel>
        </Border>

        <!-- 工具条 -->
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="保存明细修改" Command="{Binding SaveLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="删除明细行" Command="{Binding DeleteLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="确认调仓" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCommand}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.2*"/>
            </Grid.RowDefinitions>

            <!-- 源批次（tbisto） -->
            <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                    CornerRadius="3" Margin="0,0,0,6">
                <DataGrid ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                          AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" FontSize="12" Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="零件号" Binding="{Binding Nno}" Width="120"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="*"/>
                        <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" Width="70"/>
                        <DataGridTextColumn Header="仓库" Binding="{Binding Depotno}" Width="70"/>
                        <DataGridTextColumn Header="仓位" Binding="{Binding Posi}" Width="70"/>
                        <DataGridTextColumn Header="库存" Binding="{Binding Kcamount}" Width="70"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="进价" Binding="{Binding Iprc}" Width="70"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 调仓明细（tbsadc） -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3">
                <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" FontSize="12" Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="零件号" Binding="{Binding Nno}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="源仓库" Binding="{Binding Depotno}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="源仓位" Binding="{Binding Posi}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Ckamount, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="目标仓库" Binding="{Binding Depotno1, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="目标仓位" Binding="{Binding Posi1, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="进价" Binding="{Binding Iprc, Mode=OneWay}" IsReadOnly="True" Width="70"
                                            ElementStyle="{StaticResource NumCellRight}"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding M}" IsReadOnly="True" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
