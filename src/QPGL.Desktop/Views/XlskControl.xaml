<UserControl x:Class="QPGL.Desktop.Views.XlskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <!-- 复刻旧系统 fr_xlsk「业务收款单/业务付款单」布局：工具条 + 单头 + 信息区 + 明细网格 + 备注/合计底条 -->
    <DockPanel Margin="8">

        <!-- 工具条（旧界面图标按钮行） -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="查询" Command="{Binding LoadCustomerCommand}" ToolTip="载入客户未结清单（拉单）" Padding="12,4"/>
                <Button Content="载入" Command="{Binding LoadDocCommand}" ToolTip="按单号载入已有单据" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="增加" Command="{Binding NewDocCommand}" ToolTip="清屏取新号" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="提取" Command="{Binding ExtractUnsettledCommand}" ToolTip="fr_xlsk_tq：从应收应付提取未结单" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="预收款" Command="{Binding PresaleDepositCommand}" ToolTip="skinfor：录入预收定金（确认受「关闭预收款已结帐」配置控制）" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="还原" Command="{Binding RestoreCommand}" ToolTip="需要 G21 权限；已做月结拒绝" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="全选" Command="{Binding CheckAllCommand}" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="全清" Command="{Binding ClearAllCommand}" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="按金额分配" Command="{Binding AllocateCommand}" ToolTip="自动勾选收款单据" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="确认" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" Margin="16,0,0,0" Padding="20,4"/>
                <Button Content="前单" Command="{Binding PrioCommand}" Margin="16,0,0,0" Padding="12,4"/>
                <Button Content="后单" Command="{Binding NextCommand}" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="收款导入" Command="{Binding SkdrImportCommand}" ToolTip="fr_skdr：按单号批量导入收款并回填（仅收款）" Margin="6,0,0,0" Padding="12,4"/>
                <Button Content="随付打印" Command="{Binding IstofkPrintCommand}" ToolTip="re_istofk：打印勾选入库单明细（沙河丰田部署含人员分派）" Margin="6,0,0,0" Padding="12,4"/>
            </StackPanel>
        </Border>

        <!-- 单头：大标题 + 日期/单号 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag, StringFormat=业务{0}单}"
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag, StringFormat={}{0}日期}" VerticalAlignment="Center"/>
                    <DatePicker Width="110" SelectedDate="{Binding DocDate}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="销帐日期" VerticalAlignment="Center"/>
                    <DatePicker Width="110" SelectedDate="{Binding LszDate}" IsEnabled="{Binding LszDateEnabled}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="单  号:" VerticalAlignment="Center"/>
                    <TextBox Width="130" Text="{Binding Cno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 信息区：左（客户/金额/银行账号） + 右（方式/票号/余额面板） -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 左列 -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="客  户:" VerticalAlignment="Center"/>
                    <!-- 客户输入：可编辑联想下拉（旧 cmm_class FRDM 机制：拼音码 code/数字码 code1/名称/编号前缀匹配） -->
                    <Grid Grid.Column="1" Margin="4,0,6,0">
                        <TextBox x:Name="GnameBox" Text="{Binding Gname, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="GnameBox_TextChanged" PreviewKeyDown="GnameBox_PreviewKeyDown"
                                 VerticalAlignment="Center"/>
                        <Popup x:Name="CustPopup" PlacementTarget="{Binding ElementName=GnameBox}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" MinWidth="320">
                            <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="3" Margin="0,2,8,8" SnapsToDevicePixels="True">
                                <ListBox x:Name="CustList" ItemsSource="{Binding CustomerSuggestions}"
                                         MaxHeight="500" BorderThickness="0"
                                         MouseLeftButtonUp="CustList_MouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <TextBlock Text="{Binding PartNo}" Width="70" Foreground="#666"/>
                                                <TextBlock Text="{Binding PartName}" Width="170"/>
                                                <TextBlock Text="{Binding LinkMan}" Width="70" Foreground="#888"/>
                                                <TextBlock Text="{Binding Mobile}" Foreground="#888"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Grid.Column="2" Content="Go" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadCustomerCommand}"
                            VerticalAlignment="Center" Padding="14,3"/>
                    <CheckBox Grid.Column="3" Content="提取TQ" IsChecked="{Binding IncludeRebate}" VerticalAlignment="Center" Margin="10,0,0,0"
                              ToolTip="勾选后未结清单包含 pno=回扣/KH 行"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag, StringFormat={}{0}金额:}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding PaySum, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             HorizontalContentAlignment="Right" VerticalAlignment="Center" Margin="4,0,6,0"/>
                    <Button Grid.Column="2" Content="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag, StringFormat=自动勾选{0}单据}"
                            Command="{Binding AllocateCommand}" VerticalAlignment="Center" Padding="10,3"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="银行账号:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding BankNames}" SelectedItem="{Binding BankName}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>

                <!-- 右列 -->
                <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag, StringFormat={}{0}方式:}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left" ItemsSource="{Binding FkfsList}" Text="{Binding Fkfs}"
                              IsEditable="True" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="票  号:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Pno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>
                <!-- 余额面板（旧界面黄底） -->
                <Border Grid.Row="2" Grid.Column="2" Background="#FFFDF3D0" BorderBrush="#E0C878" BorderThickness="1"
                        CornerRadius="3" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前余额：" VerticalAlignment="Center"/>
                            <TextBlock Text="收款后余额：" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Yue, StringFormat=N2}" FontWeight="Bold" FontFamily="{StaticResource NumFontFamily}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding YueAfter, StringFormat=N2}" FontWeight="Bold" FontFamily="{StaticResource NumFontFamily}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBlock Text="可用总金额：" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding YueAbs, StringFormat=N2}" FontWeight="Bold" FontFamily="{StaticResource NumFontFamily}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 底条：消息 + 备注 + 合计 -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,5" Margin="0,6,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="合  计:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SumJe, StringFormat=N2}" Style="{StaticResource NumCellRightNeg}" Width="90" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SumYsje, StringFormat=N2}" Style="{StaticResource NumCellRightNeg}" Width="90" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SumWsje, StringFormat=N2}" Style="{StaticResource NumCellRightNeg}" Width="90" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SumBcje, StringFormat=N2}" Style="{StaticResource NumCellRightNeg}" Width="90" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" MaxWidth="360"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag, StringFormat={}{0}备注:}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox Width="220" Text="{Binding Xm, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 明细网格（旧列序：业务类型/业务单号/日期/金额/已收/未收/本次…收款勾选列在末） -->
        <DataGrid ItemsSource="{Binding Lines}" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="业务类型" Binding="{Binding Type}" Width="70"/>
                <DataGridTextColumn Header="业务单号" Binding="{Binding Paper}" Width="120"/>
                <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy.MM.dd}" Width="90"/>
                <DataGridTextColumn Header="金额" Binding="{Binding Je, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumCellRightNeg}"/>
                <DataGridTextColumn Header="已收金额" Binding="{Binding Ysje, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumCellRightNeg}"/>
                <DataGridTextColumn Header="未收金额" Binding="{Binding Wsje, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumCellRightNeg}"/>
                <DataGridTextColumn Header="{Binding ColBc}" Binding="{Binding Bcje, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="95"
                                    ElementStyle="{StaticResource NumCellRightNeg}" IsReadOnly="False"/>
                <DataGridTextColumn Header="车牌" Binding="{Binding Ch}" Width="75"/>
                <DataGridTextColumn Header="车型" Binding="{Binding Dp}" Width="85"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                <DataGridCheckBoxColumn Header="{Binding ColMark}" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="45" IsReadOnly="False"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
