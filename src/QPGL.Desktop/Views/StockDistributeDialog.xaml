<Window x:Class="QPGL.Desktop.Views.StockDistributeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="库存分货（fr_kcfh）" Height="560" Width="860"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 过滤条 -->
        <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="客户名称" VerticalAlignment="Center"/>
                <TextBox Width="160" Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,16,0"/>
                <TextBlock Text="订单号" VerticalAlignment="Center"/>
                <TextBox Width="160" Text="{Binding CnoFilter, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,16,0"/>
                <Button Content="查询" Command="{Binding SearchCommand}" Padding="18,3"/>
            </StackPanel>
        </Border>

        <!-- 分货选项（row23 UI：分货方式 / 取整 / 出库价基准列×系数 / 库号） -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="分货方式" VerticalAlignment="Center"/>
                <ComboBox Width="110" Margin="4,0,16,0" SelectedIndex="{Binding Mode}">
                    <ComboBoxItem>1 按需求</ComboBoxItem>
                    <ComboBoxItem>2 按比例</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="价格取整" VerticalAlignment="Center"/>
                <ComboBox Width="110" Margin="4,0,16,0" SelectedIndex="{Binding RoundMode}">
                    <ComboBoxItem>1 保留小数</ComboBoxItem>
                    <ComboBoxItem>2 四舍五入</ComboBoxItem>
                    <ComboBoxItem>3 进 1 取整</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="出库价基准列" VerticalAlignment="Center"/>
                <ComboBox Width="90" Margin="4,0,4,0" SelectedValue="{Binding OprcField}">
                    <ComboBoxItem Content="iprc"/>
                    <ComboBoxItem Content="oprc"/>
                    <ComboBoxItem Content="oprb"/>
                    <ComboBoxItem Content="iprj"/>
                </ComboBox>
                <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0"/>
                <TextBox Width="70" Text="{Binding OprcFactor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
                <TextBlock Text="库号" VerticalAlignment="Center"/>
                <TextBox Width="90" Text="{Binding Depotno, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 订单明细 -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3">
            <DataGrid ItemsSource="{Binding Lines}" Margin="1" CanUserDeleteRows="False"
                      AutoGenerateColumns="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                    <DataGridTextColumn Header="客户" Binding="{Binding Gname}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="订单号" Binding="{Binding Cno}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="订货量" Binding="{Binding Oqty}" IsReadOnly="True" Width="75"/>
                    <DataGridTextColumn Header="已分货" Binding="{Binding Fqty}" IsReadOnly="True" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 操作条 -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10,6" Margin="0,8,0,0">
            <DockPanel>
                <Button Content="执行分货" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExecuteCommand}" DockPanel.Dock="Right"/>
                <Button Content="关闭" DockPanel.Dock="Right" Margin="0,0,8,0" Click="Close_Click"/>
                <TextBlock Text="勾选订单后执行：按需求=MIN(库存,缺口)；按比例=分货量0剔除；生成 type='调拨' 单（guno='其它'）"
                           Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
