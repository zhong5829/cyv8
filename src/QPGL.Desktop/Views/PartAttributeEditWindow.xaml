<Window x:Class="QPGL.Desktop.Views.PartAttributeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="零件属性添加/修改" Width="520" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#ECE9D8">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左列（旧 frmAdd 布局：NNO/NA1/TY/FA/DC/UNIT/IPRJ/CODE_TS/low_rate） -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="零件编码：" VerticalAlignment="Center"/>
        <TextBox x:Name="NnoBox" Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="零件名：" VerticalAlignment="Center"/>
        <TextBox x:Name="Na1Box" Grid.Row="1" Grid.Column="1" Width="170" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#CCFFCC"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="车型：" VerticalAlignment="Center"/>
        <TextBox x:Name="TyBox" Grid.Row="2" Grid.Column="1" Width="170" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="产地：" VerticalAlignment="Center"/>
        <ComboBox x:Name="FaBox" Grid.Row="3" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" IsEditable="True"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="分类码：" VerticalAlignment="Center"/>
        <ComboBox x:Name="DcBox" Grid.Row="4" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" IsEditable="True"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="材料单位：" VerticalAlignment="Center"/>
        <ComboBox x:Name="UnitBox" Grid.Row="5" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" IsEditable="True"/>
        <TextBlock Grid.Row="6" Grid.Column="0" Text="含税价：" VerticalAlignment="Center"/>
        <TextBox x:Name="IprjBox" Grid.Row="6" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="7" Grid.Column="0" Text="税号：" VerticalAlignment="Center"/>
        <TextBox x:Name="CodeTsBox" Grid.Row="7" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" LostFocus="CodeTsBox_LostFocus"/>
        <TextBlock Grid.Row="8" Grid.Column="0" Text="税率：" VerticalAlignment="Center"/>
        <TextBox x:Name="RateBox" Grid.Row="8" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center"
                 IsReadOnly="True" Background="#99CCFF" ToolTip="按税号从分类码表（tbcomplex）带出 low_rate"/>

        <!-- 右列（NNP/NNQ/XNO/TNO/UQTY/NVOL=体积/SUTTLE=净重/OPRC_CP=统一售价；AMJJ/BMJJ 旧码隐藏不显示） -->
        <TextBlock Grid.Row="0" Grid.Column="2" Text="编码一：" Margin="24,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="NnpBox" Grid.Row="0" Grid.Column="3" Width="120" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="编码二：" Margin="24,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="NnqBox" Grid.Row="1" Grid.Column="3" Width="120" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="通用码：" Margin="24,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="XnoBox" Grid.Row="2" Grid.Column="3" Width="120" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="套件码：" Margin="24,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="TnoBox" Grid.Row="3" Grid.Column="3" Width="120" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="4" Grid.Column="2" Text="最小包装数：" Margin="24,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="UqtyBox" Grid.Row="4" Grid.Column="3" Width="120" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="5" Grid.Column="2" Text="体积：" Margin="24,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="NvolBox" Grid.Row="5" Grid.Column="3" Width="120" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="6" Grid.Column="2" Text="净重：" Margin="24,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="SuttleBox" Grid.Row="6" Grid.Column="3" Width="120" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="7" Grid.Column="2" Text="统一售价：" Margin="24,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="OprcCpBox" Grid.Row="7" Grid.Column="3" Width="120" VerticalAlignment="Center"/>

        <!-- 全宽行（旧码 Width=360 跨两列） -->
        <TextBlock Grid.Row="9" Grid.Column="0" Text="英文名：" VerticalAlignment="Center"/>
        <TextBox x:Name="EngBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="10" Grid.Column="0" Text="零件说明：" VerticalAlignment="Center"/>
        <TextBox x:Name="Note1Box" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="11" Grid.Column="0" Text="备注：" VerticalAlignment="Top" Margin="0,6,0,0"/>
        <TextBox x:Name="NoteBox" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

        <!-- 底部按钮（旧 \<K.确定 / \<C.取消） -->
        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="_K. 确定" Width="80" Height="24" Margin="0,0,24,0"
                    IsDefault="True" Click="OkButton_Click"/>
            <Button Content="_C. 取消" Width="80" Height="24" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
