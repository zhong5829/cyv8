<Window x:Class="QPGL.Desktop.Views.InStockLineEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入库明细编辑" Width="480" Height="560"
        WindowStartupLocation="CenterOwner" MinWidth="440" MinHeight="500"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <!-- 配件信息 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="配件编号: " VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCp" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="内部编号: " VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtNno" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="配件名称: " VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtNa1" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap"/>
            </Grid>

            <!-- 数量 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="进货数量*: " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtQty" Grid.Column="1" Text="1" Margin="0,1"/>
            </Grid>

            <!-- 进价（不含税）/ 含税价 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="进价(不含税)*: " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtIprj" Grid.Column="1" Margin="0,1"/>
                <TextBlock Grid.Column="2" Text="含税价: " VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtIprc" Grid.Column="3" Margin="0,1"/>
            </Grid>

            <!-- 售价 / 批发价 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="售价: " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtOprc" Grid.Column="1" Margin="0,1"/>
                <TextBlock Grid.Column="2" Text="批发价: " VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtOprb" Grid.Column="3" Margin="0,1"/>
            </Grid>

            <!-- 库号 / 仓位 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="库号: " VerticalAlignment="Center"/>
                <ComboBox x:Name="CboDepotno" Grid.Column="1" Margin="0,1"/>
                <TextBlock Grid.Column="2" Text="仓位: " VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtPosi" Grid.Column="3" Margin="0,1"/>
            </Grid>

            <!-- 分类码 / 产地 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="分类码: " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtFa" Grid.Column="1" Margin="0,1"/>
                <TextBlock Grid.Column="2" Text="产地: " VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtDc" Grid.Column="3" Margin="0,1"/>
            </Grid>

            <!-- 单位 / 车型 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="单位: " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtUnit" Grid.Column="1" Margin="0,1"/>
                <TextBlock Grid.Column="2" Text="车型: " VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtTy" Grid.Column="3" Margin="0,1"/>
            </Grid>

            <!-- 备注 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="备注: " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtNote" Grid.Column="1" Margin="0,1"/>
            </Grid>

            <TextBlock x:Name="TxtStockInfo" TextWrapping="Wrap" Foreground="#555" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="BtnOk" Content="确认 (Enter)" Width="100" Height="30" Margin="4,0"
                    Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="取消 (Esc)" Width="90" Height="30" Margin="4,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
