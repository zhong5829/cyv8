<UserControl x:Class="QPGL.Desktop.Views.ReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:QPGL.Desktop.Views">
    <UserControl.Resources>
        <v:PriceMaskConverter x:Key="MaskCost" Kind="Cost"/>
        <v:PriceMaskConverter x:Key="MaskProfit" Kind="Profit"/>
        <v:PriceMaskConverter x:Key="MaskIprj" Kind="Iprj"/>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="#C0392B" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TabControl>
            <!-- D3 日报表 -->
            <TabItem Header="日报表">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="日期：" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding DailyDate}" Width="120" Margin="0,0,8,0"/>
                        <Button Content="查询" Command="{Binding LoadDailyCommand}"/>
                    </StackPanel>
                    <TabControl>
                        <TabItem Header="当日销售">
                            <DataGrid ItemsSource="{Binding DailySales}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="单号" Binding="{Binding Paper}" Width="100"/>
                                    <DataGridTextColumn Header="客户" Binding="{Binding Gname}" Width="140"/>
                                    <DataGridTextColumn Header="数量" Binding="{Binding Ckamount}" Width="70"/>
                                    <DataGridTextColumn Header="成本" Binding="{Binding Iprc, Converter={StaticResource MaskCost}}" Width="90"/>
                                    <DataGridTextColumn Header="销售额" Binding="{Binding Oprc}" Width="90"/>
                                    <DataGridTextColumn Header="实收额" Binding="{Binding Oprct}" Width="90"/>
                                    <DataGridTextColumn Header="折扣" Binding="{Binding Yhl}" Width="60"/>
                                    <DataGridTextColumn Header="付款方式" Binding="{Binding Guno}" Width="80"/>
                                    <DataGridTextColumn Header="操作员" Binding="{Binding Per}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="结账销售">
                            <DataGrid ItemsSource="{Binding DailySettled}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="单号" Binding="{Binding Paper}" Width="100"/>
                                    <DataGridTextColumn Header="客户" Binding="{Binding Gname}" Width="140"/>
                                    <DataGridTextColumn Header="数量" Binding="{Binding Ckamount}" Width="70"/>
                                    <DataGridTextColumn Header="成本" Binding="{Binding Iprc, Converter={StaticResource MaskCost}}" Width="90"/>
                                    <DataGridTextColumn Header="销售额" Binding="{Binding Oprc}" Width="90"/>
                                    <DataGridTextColumn Header="实收额" Binding="{Binding Oprct}" Width="90"/>
                                    <DataGridTextColumn Header="付款方式" Binding="{Binding Guno}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="当日入库">
                            <DataGrid ItemsSource="{Binding DailyInStock}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="入库单号" Binding="{Binding Cno}" Width="110"/>
                                    <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" Width="140"/>
                                    <DataGridTextColumn Header="行数" Binding="{Binding Item}" Width="50"/>
                                    <DataGridTextColumn Header="数量" Binding="{Binding Jkamount}" Width="70"/>
                                    <DataGridTextColumn Header="外币金额" Binding="{Binding Iprj, Converter={StaticResource MaskIprj}}" Width="90"/>
                                    <DataGridTextColumn Header="进价金额" Binding="{Binding Iprc, Converter={StaticResource MaskCost}}" Width="90"/>
                                    <DataGridTextColumn Header="仓库" Binding="{Binding Depotno}" Width="60"/>
                                    <DataGridTextColumn Header="付款方式" Binding="{Binding Fkfs}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="当日调拨">
                            <DataGrid ItemsSource="{Binding DailyTransfers}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="单号" Binding="{Binding Paper}" Width="100"/>
                                    <DataGridTextColumn Header="对方" Binding="{Binding Gname}" Width="140"/>
                                    <DataGridTextColumn Header="数量" Binding="{Binding Ckamount}" Width="70"/>
                                    <DataGridTextColumn Header="销售额" Binding="{Binding Oprc}" Width="90"/>
                                    <DataGridTextColumn Header="实收额" Binding="{Binding Oprct}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>
            <!-- D4 月销售数统计 -->
            <TabItem Header="月销售数统计">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="厂牌：" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding MonthlyCp}" Width="70" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="零件/名称：" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding MonthlyKeyword}" Width="120" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                        <Button Content="查询" Command="{Binding LoadMonthlyCommand}" Margin="0,0,20,0"/>
                        <TextBlock Text="{Binding MonthlyYear, StringFormat=yyyy}" VerticalAlignment="Center"/>
                        <TextBlock Text=" 年 " VerticalAlignment="Center"/>
                        <TextBox Text="{Binding MonthlyMonth}" Width="36" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="月" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox Content="含调拨" IsChecked="{Binding MonthlyIncludeTransfer}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox Content="仅正数" IsChecked="{Binding MonthlyOnlyPositive}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox Content="覆盖已有统计" IsChecked="{Binding MonthlyForce}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="月末处理" Command="{Binding PostMonthlyCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding MonthlyRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="零件编码" Binding="{Binding Nno}" Width="130"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="160"/>
                            <DataGridTextColumn Header="1月" Binding="{Binding Oamou1}" Width="55"/>
                            <DataGridTextColumn Header="2月" Binding="{Binding Oamou2}" Width="55"/>
                            <DataGridTextColumn Header="3月" Binding="{Binding Oamou3}" Width="55"/>
                            <DataGridTextColumn Header="4月" Binding="{Binding Oamou4}" Width="55"/>
                            <DataGridTextColumn Header="5月" Binding="{Binding Oamou5}" Width="55"/>
                            <DataGridTextColumn Header="6月" Binding="{Binding Oamou6}" Width="55"/>
                            <DataGridTextColumn Header="7月" Binding="{Binding Oamou7}" Width="55"/>
                            <DataGridTextColumn Header="8月" Binding="{Binding Oamou8}" Width="55"/>
                            <DataGridTextColumn Header="9月" Binding="{Binding Oamou9}" Width="55"/>
                            <DataGridTextColumn Header="10月" Binding="{Binding Oamou10}" Width="55"/>
                            <DataGridTextColumn Header="11月" Binding="{Binding Oamou11}" Width="55"/>
                            <DataGridTextColumn Header="12月" Binding="{Binding Oamou12}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- D5 进销存分类统计 -->
            <TabItem Header="进销存分类统计">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="起始日期：" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding JxcBdate}" Width="120" Margin="0,0,8,0"/>
                        <Button Content="查询" Command="{Binding LoadJxcCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding JxcRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" Width="90"/>
                            <DataGridTextColumn Header="销售数量" Binding="{Binding XsAmou}" Width="80"/>
                            <DataGridTextColumn Header="销售收入" Binding="{Binding XsJine}" Width="100"/>
                            <DataGridTextColumn Header="毛利" Binding="{Binding Ml, Converter={StaticResource MaskProfit}}" Width="100"/>
                            <DataGridTextColumn Header="毛利率" Binding="{Binding Mll, Converter={StaticResource MaskProfit}}" Width="70"/>
                            <DataGridTextColumn Header="退货数量" Binding="{Binding ThAmou}" Width="80"/>
                            <DataGridTextColumn Header="退货金额" Binding="{Binding ThJine}" Width="100"/>
                            <DataGridTextColumn Header="入库数量" Binding="{Binding InAmou}" Width="80"/>
                            <DataGridTextColumn Header="入库金额" Binding="{Binding InJine}" Width="100"/>
                            <DataGridTextColumn Header="库存数量" Binding="{Binding KcAmou}" Width="80"/>
                            <DataGridTextColumn Header="库存金额" Binding="{Binding KcJine}" Width="100"/>
                            <DataGridTextColumn Header="销售成本" Binding="{Binding Iprc, Converter={StaticResource MaskCost}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- D6 进销存统计（日汇总） -->
            <TabItem Header="进销存统计（日汇总）">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="起：" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding JxcD0}" Width="110" Margin="0,0,8,0"/>
                        <TextBlock Text="止：" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding JxcD1}" Width="110" Margin="0,0,8,0"/>
                        <TextBlock Text="厂牌：" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding MonthlyCp}" Width="70" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                        <Button Content="查询" Command="{Binding LoadJxcDailyCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding JxcDailyRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="90"/>
                            <DataGridTextColumn Header="期初库存" Binding="{Binding Qckc}" Width="70"/>
                            <DataGridTextColumn Header="期初金额" Binding="{Binding Qckcj}" Width="85"/>
                            <DataGridTextColumn Header="进库数" Binding="{Binding Jk}" Width="65"/>
                            <DataGridTextColumn Header="进库金额" Binding="{Binding Jkj}" Width="85"/>
                            <DataGridTextColumn Header="销售数" Binding="{Binding Xs}" Width="65"/>
                            <DataGridTextColumn Header="销售金额" Binding="{Binding Xsj}" Width="85"/>
                            <DataGridTextColumn Header="调拨数" Binding="{Binding Db}" Width="65"/>
                            <DataGridTextColumn Header="调拨金额" Binding="{Binding Dbj}" Width="85"/>
                            <DataGridTextColumn Header="领料数" Binding="{Binding Wx}" Width="65"/>
                            <DataGridTextColumn Header="领料金额" Binding="{Binding Wxj}" Width="85"/>
                            <DataGridTextColumn Header="纠正数" Binding="{Binding Xg}" Width="65"/>
                            <DataGridTextColumn Header="纠正金额" Binding="{Binding Xgj}" Width="85"/>
                            <DataGridTextColumn Header="归库数" Binding="{Binding Gk}" Width="65"/>
                            <DataGridTextColumn Header="归库金额" Binding="{Binding Gkj}" Width="85"/>
                            <DataGridTextColumn Header="差价数" Binding="{Binding Cj}" Width="65"/>
                            <DataGridTextColumn Header="差价金额" Binding="{Binding Cjj}" Width="85"/>
                            <DataGridTextColumn Header="期末库存" Binding="{Binding Qmkc}" Width="70"/>
                            <DataGridTextColumn Header="期末金额" Binding="{Binding Qmkcj}" Width="85"/>
                            <DataGridTextColumn Header="出库合计数" Binding="{Binding Ck}" Width="75"/>
                            <DataGridTextColumn Header="出库金额" Binding="{Binding Ckj}" Width="85"/>
                            <DataGridTextColumn Header="出库毛利" Binding="{Binding Ckml, Converter={StaticResource MaskProfit}}" Width="85"/>
                            <DataGridTextColumn Header="出库售价" Binding="{Binding Ckoprc}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- D7 新增客户分析 -->
            <TabItem Header="新增客户分析">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="起：" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding CustD1}" Width="110" Margin="0,0,8,0"/>
                        <TextBlock Text="止：" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding CustD2}" Width="110" Margin="0,0,8,0"/>
                        <Button Content="查询" Command="{Binding LoadNewCustomersCommand}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0" ItemsSource="{Binding NewCustomerMonths}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,4,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="年月" Binding="{Binding Ym}" Width="90"/>
                                <DataGridTextColumn Header="新增客户数" Binding="{Binding Count}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="1" ItemsSource="{Binding NewCustomerDetails}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="年月" Binding="{Binding Months}" Width="80"/>
                                <DataGridTextColumn Header="客户" Binding="{Binding Gname}" Width="140"/>
                                <DataGridTextColumn Header="联系人" Binding="{Binding Lxr}" Width="80"/>
                                <DataGridTextColumn Header="电话" Binding="{Binding Lxrtel}" Width="100"/>
                                <DataGridTextColumn Header="首单日期" Binding="{Binding Jcdate, StringFormat=yyyy-MM-dd}" Width="90"/>
                                <DataGridTextColumn Header="累计消费" Binding="{Binding Oprc}" Width="90"/>
                                <DataGridTextColumn Header="地址" Binding="{Binding Lxradr}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
            <!-- D8 流失客户分析 -->
            <TabItem Header="流失客户分析">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="起：" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding CustD1}" Width="110" Margin="0,0,8,0"/>
                        <TextBlock Text="止：" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding CustD2}" Width="110" Margin="0,0,8,0"/>
                        <TextBlock Text="流失天数阈值：" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding LostThresholdDays}" Width="60" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="查询" Command="{Binding LoadLostCustomersCommand}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0" ItemsSource="{Binding LostCustomerMonths}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,4,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="年月" Binding="{Binding Ym}" Width="90"/>
                                <DataGridTextColumn Header="流失客户数" Binding="{Binding Count}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="1" ItemsSource="{Binding LostCustomerDetails}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="年月" Binding="{Binding Months}" Width="80"/>
                                <DataGridTextColumn Header="客户" Binding="{Binding Gname}" Width="140"/>
                                <DataGridTextColumn Header="联系人" Binding="{Binding Lxr}" Width="80"/>
                                <DataGridTextColumn Header="电话" Binding="{Binding Lxrtel}" Width="100"/>
                                <DataGridTextColumn Header="最后交易" Binding="{Binding Jcdate, StringFormat=yyyy-MM-dd}" Width="90"/>
                                <DataGridTextColumn Header="地址" Binding="{Binding Lxradr}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
