<UserControl x:Class="QPGL.Desktop.Views.OrderInControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <!-- 顶部：选单条件条（2026-11-03 改版：选订单 → 自动加载明细 → 改到货数 → 更新库存，无草稿中间态） -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="厂牌：" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Cp}" Width="70" Margin="0,0,12,0" VerticalContentAlignment="Center" IsReadOnly="True"/>
                <TextBlock Text="选择订单：" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding OpenOrders}" SelectedItem="{Binding SelectedOrder}"
                          DisplayMemberPath="Label" Width="240" Margin="0,0,12,0" VerticalContentAlignment="Center"
                          ToolTip="列出有缺口未入完的订单（订单生成生成的订单）"/>
                <Button Content="刷新订单" Command="{Binding LoadOrdersCommand}" Margin="0,0,8,0"/>
                <Button Content="重载明细" Command="{Binding LoadLinesCommand}" Margin="0,0,16,0"/>
                <CheckBox Content="更新档案进价" IsChecked="{Binding UpdateProfileIprj}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 底部：确认 + 消息 -->
        <StackPanel DockPanel.Dock="Bottom">
            <WrapPanel Margin="0,6,0,0">
                <Button Content="更新库存（确认入库）" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCommand}"
                        ToolTip="按勾选行的本次到货数确认入库：写进仓台账；直发客户行生成销售单；订单累计封顶订数"/>
            </WrapPanel>
            <TextBlock Text="{Binding Message}" Foreground="#C0392B" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 中部：到货明细 -->
        <DataGrid x:Name="ArrivalGrid" ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  IsReadOnly="False"
                   FontSize="12" Margin="0,4,0,4"
                  MouseDoubleClick="ArrivalGrid_MouseDoubleClick" PreparingCellForEdit="ArrivalGrid_PreparingCellForEdit">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选" Binding="{Binding IsPick, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                <DataGridTextColumn Header="订单号" Binding="{Binding Cno}" IsReadOnly="True" Width="66"/>
                <DataGridTextColumn Header="源单号" Binding="{Binding Orno}" IsReadOnly="True" Width="66"/>
                <DataGridTextColumn Header="序" Binding="{Binding Item}" IsReadOnly="True" Width="36"/>
                <DataGridTextColumn Header="零件编码" Binding="{Binding Nno}" IsReadOnly="True" Width="96"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True" Width="42"/>
                <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="78"/>
                <DataGridTextColumn Header="直发客户" Binding="{Binding Gname}" IsReadOnly="True" Width="78"/>
                <DataGridTextColumn Header="订数" Binding="{Binding Oqty, Mode=OneWay, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="60"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="本次到货数" Binding="{Binding ArriveQty, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource QtyInt}}" Width="80"
                                    ElementStyle="{StaticResource NumCellRight}" EditingElementStyle="{StaticResource QtyCellEdit}"/>
                <DataGridTextColumn Header="进价" Binding="{Binding Iprc, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="售价" Binding="{Binding Oprc, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="批价" Binding="{Binding Oprb, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="仓位" Binding="{Binding Posi, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
