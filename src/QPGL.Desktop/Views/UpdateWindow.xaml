<Window x:Class="QPGL.Desktop.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="在线更新" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <StackPanel Margin="16">
        <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="13"/>
        <ProgressBar x:Name="Progress" Height="18" Margin="0,14,0,4" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="#666666"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnCancel" Content="取消" Width="88" Height="26" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
