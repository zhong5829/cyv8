<Window x:Class="QPGL.Desktop.Views.PrintFooterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印设置 - 票头/票尾" Height="520" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 票头公司信息（只读，旧系统统一维护） -->
        <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="票头公司信息（tbsysset system 段，由旧系统统一维护，只读）"
                           FontSize="12" Foreground="#666" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding CompanyInfo}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 票尾编辑 -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="12,8">
            <StackPanel>
                <TextBlock Text="票尾声明（写入 tbsysset RPSET1/RPSET2，与旧 VFP 客户端共享，两处打印结果一致）"
                           FontSize="12" Foreground="#666" Margin="0,0,0,6"/>
                <TextBlock Text="第一段（RPSET1）" FontSize="12" Margin="0,0,0,2"/>
                <TextBox x:Name="Part1Box" Height="52" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Margin="0,0,0,8"/>
                <TextBlock Text="第二段（RPSET2）" FontSize="12" Margin="0,0,0,2"/>
                <TextBox x:Name="Part2Box" Height="52" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource WarnBrush}"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="保存票尾" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="关闭" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
