<UserControl x:Class="QPGL.Desktop.Views.FinReportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="会计期间" VerticalAlignment="Center"/>
                <TextBox Width="70" Text="{Binding Period}" Margin="4,0,10,0"/>
                <CheckBox Content="历史期（finhisbal）" IsChecked="{Binding UseHisbal}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox Content="仅该级次" IsChecked="{Binding ExactLevel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="科目" VerticalAlignment="Center"/>
                <TextBox Width="80" Text="{Binding Sub0}" Margin="4,0,10,0"/>
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}"/>
            </StackPanel>
        </Border>
        <TabControl>
            <TabItem Header="试算平衡">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="查询试算平衡" Command="{Binding SearchTrialCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    <DataGrid ItemsSource="{Binding TrialRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="科目代码" Binding="{Binding Subcode}" Width="110"/>
                            <DataGridTextColumn Header="科目名称" Binding="{Binding Subname}" Width="*"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding Fdc}" Width="44"/>
                            <DataGridTextColumn Header="年初借" Binding="{Binding Ybdesum, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="年初贷" Binding="{Binding Ybcresum, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="期初借" Binding="{Binding Bdesum, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="期初贷" Binding="{Binding Bcresum, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="本期借" Binding="{Binding Cdesum, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="本期贷" Binding="{Binding Ccresum, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="本年借" Binding="{Binding Ydesum, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="本年贷" Binding="{Binding Ycresum, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="期末借" Binding="{Binding Edesum, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="期末贷" Binding="{Binding Ecresum, StringFormat=N2}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="凭证汇总表">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="起" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding BDate}" Width="110" Margin="4,0,8,0"/>
                        <TextBlock Text="止" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding EDate}" Width="110" Margin="4,0,8,0"/>
                        <TextBlock Text="凭证字" VerticalAlignment="Center"/>
                        <TextBox Width="70" Text="{Binding Vouword}" Margin="4,0,8,0"/>
                        <CheckBox Content="仅过帐" IsChecked="{Binding OnlyPosted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox Content="仅未过帐" IsChecked="{Binding IncludeUnposted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="查询汇总" Command="{Binding SearchSummaryCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding SummaryRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="科目代码" Binding="{Binding Subcode}" Width="110"/>
                            <DataGridTextColumn Header="科目名称" Binding="{Binding Subname}" Width="*"/>
                            <DataGridTextColumn Header="借方" Binding="{Binding Debit, StringFormat=N2}" Width="140"/>
                            <DataGridTextColumn Header="贷方" Binding="{Binding Credit, StringFormat=N2}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="损益表">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="求值（Sum）" Command="{Binding SumProlCommand}" Margin="0,0,8,0"/>
                        <Button Content="保存（finprol 重写）" Command="{Binding SaveProlCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ProlRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行号" Binding="{Binding Reid}" Width="50"/>
                            <DataGridTextColumn Header="项目" Binding="{Binding Itemna}" Width="*"/>
                            <DataGridTextColumn Header="本期金额" Binding="{Binding Csum, StringFormat=N2}" Width="130"/>
                            <DataGridTextColumn Header="本年累计" Binding="{Binding Nsum, StringFormat=N2}" Width="130"/>
                            <DataGridTextColumn Header="本期表达式" Binding="{Binding Cexpress}" Width="180"/>
                            <DataGridTextColumn Header="累计表达式" Binding="{Binding Nexpress}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="资产负债表">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="求值（Sum）" Command="{Binding SumBsCommand}" Margin="0,0,8,0"/>
                        <Button Content="保存（finbs 重写）" Command="{Binding SaveBsCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding BsRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行" Binding="{Binding Reno}" Width="40"/>
                            <DataGridTextColumn Header="资产" Binding="{Binding Asset}" Width="*"/>
                            <DataGridTextColumn Header="期初" Binding="{Binding Absum, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="期末" Binding="{Binding Aesum, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="负债及权益" Binding="{Binding Queer}" Width="*"/>
                            <DataGridTextColumn Header="期初" Binding="{Binding Qbsum, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="期末" Binding="{Binding Qesum, StringFormat=N2}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="现金流量表">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="求值（Sum）" Command="{Binding SumCashCommand}" Margin="0,0,8,0"/>
                        <Button Content="保存（fincash 重写）" Command="{Binding SaveCashCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding CashRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目号" Binding="{Binding Cashid}" Width="80"/>
                            <DataGridTextColumn Header="项目名称" Binding="{Binding Cashna}" Width="*"/>
                            <DataGridTextColumn Header="金额" Binding="{Binding Balance, StringFormat=N2}" Width="150"/>
                            <DataGridTextColumn Header="表达式" Binding="{Binding Express}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
