<Window x:Class="QPGL.Desktop.Views.PartPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择配件" Width="1200" Height="750"
        WindowStartupLocation="CenterOwner" MinWidth="950" MinHeight="560"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2.4*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 三条件查询条（与开单页同构：编码=内部编号包含，名称=拼音码/编码/名称/车型；左右方向键切换输入框并全选） -->
        <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="编码" VerticalAlignment="Center"/>
                <TextBox x:Name="CpBox" Width="150" Margin="4,0,16,0" TextChanged="Box_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         ToolTip="查内部编号：缺省前缀匹配（输 pt 只查 PT 开头）；输 /pt 转包含匹配（PT/OPT 等含 pt 的都命中）；←/→ 切换条件框"/>
                <TextBlock Text="名称" VerticalAlignment="Center"/>
                <TextBox x:Name="Na1Box" Width="220" Margin="4,0,16,0" TextChanged="Box_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         ToolTip="支持拼音码/编码/名称/车型；←/→ 切换条件框"/>
                <TextBlock Text="车型" VerticalAlignment="Center"/>
                <TextBox x:Name="TyBox" Width="180" Margin="4,0,8,0" TextChanged="Box_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         ToolTip="←/→ 切换条件框"/>
                <Button Content="新增编码" Margin="0,0,16,0" Padding="10,0" MinWidth="72" Height="26" Click="BtnNewPart_Click"
                        ToolTip="新增零件属性编码（确定后直接选定该配件继续入库）"/>
                <TextBlock Text="输入即搜（0.5 秒），←/→ 切换条件框，双击结果行选定配件" Foreground="#888" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 上：配件列表（无限滑动加载） -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3">
            <DataGrid x:Name="PartGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" FontSize="12" Margin="1"
                      MouseDoubleClick="PartGrid_MouseDoubleClick" PreviewKeyDown="PartGrid_PreviewKeyDown"
                      SelectionChanged="PartGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="配件编号" Binding="{Binding Cp}" Width="100"/>
                    <DataGridTextColumn Header="内部编号" Binding="{Binding Nno}" Width="110"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="*"/>
                    <DataGridTextColumn Header="车型" Binding="{Binding Ty}" Width="90"/>
                    <DataGridTextColumn Header="货位" Binding="{Binding Posi}" Width="70"/>
                    <DataGridTextColumn Header="仓库" Binding="{Binding Depotno}" Width="60"/>
                    <DataGridTextColumn Header="库存" Binding="{Binding Kcamount, Converter={StaticResource QtyInt}}" Width="70"/>
                    <DataGridTextColumn Header="进价(不含税)" Binding="{Binding Iprj, StringFormat=N2}" Width="95"/>
                    <DataGridTextColumn Header="进价(含税)" Binding="{Binding Iprc, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="零售价" Binding="{Binding Oprc, StringFormat=N2}" Width="75"/>
                    <DataGridTextColumn Header="批发价" Binding="{Binding Oprb, StringFormat=N2}" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 下：左进货历史 / 右销售历史（选中配件） -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="进货历史（选中配件）" FontWeight="Bold" Margin="2,0,0,3"/>
                <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3">
                    <DataGrid ItemsSource="{Binding InRecords}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" FontSize="12" Margin="1" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding Indate, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="160"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Jkamount, Mode=OneWay, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="80"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="进价" Binding="{Binding Iprc, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="90"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="销售历史（选中配件）" FontWeight="Bold" Margin="2,0,0,3"/>
                <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3">
                    <DataGrid ItemsSource="{Binding SaleRecords}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" FontSize="12" Margin="1" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding Outdate, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="客户" Binding="{Binding Gname}" IsReadOnly="True" Width="160"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Ckamount, Mode=OneWay, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="80"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="售价" Binding="{Binding Oprc, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="90"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="业务员" Binding="{Binding Per}" IsReadOnly="True" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#888"/>
            <Button Content="取消 (Esc)" Width="90" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
