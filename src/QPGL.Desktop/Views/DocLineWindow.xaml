<Window x:Class="QPGL.Desktop.Views.DocLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="单据明细" Height="460" Width="880"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource WindowBackBrush}">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="单号：" FontWeight="Bold"/>
                <TextBlock x:Name="TxtPaper" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" Margin="0,0,16,0"/>
                <TextBlock Text="类型：" />
                <TextBlock x:Name="TxtType" Margin="0,0,16,0"/>
                <TextBlock Text="日期："/>
                <TextBlock x:Name="TxtDate" Margin="0,0,16,0"/>
                <TextBlock Text="客户："/>
                <TextBlock x:Name="TxtGname" Margin="0,0,16,0"/>
                <TextBlock Text="收款："/>
                <TextBlock x:Name="TxtMark" Foreground="{StaticResource OkBrush}" FontWeight="Bold"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编码" Binding="{Binding Cp}" Width="80"/>
                <DataGridTextColumn Header="零件号" Binding="{Binding Nno}" Width="120"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="180"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Ckamount}" Width="70"/>
                <DataGridTextColumn Header="单价" Binding="{Binding Oprc, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="实收价" Binding="{Binding Oprct, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="折后金额" Binding="{Binding Yhloprct, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="货位" Binding="{Binding Posi}" Width="70"/>
                <DataGridTextColumn Header="仓库" Binding="{Binding Depotno}" Width="70"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
