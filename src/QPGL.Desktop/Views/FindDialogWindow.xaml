<Window x:Class="QPGL.Desktop.Views.FindDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查询条件" Width="760" Height="560" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="生成" Width="88" Height="28" Click="OnBuild"/>
            <Button Content="取消" Width="88" Height="28" Margin="10,0,0,0" Click="OnCancel"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 左：字段 + 快捷条件 -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="快捷条件" FontWeight="Bold" Margin="2,0,0,4"/>
                <ListBox x:Name="LstShortcut" Height="130" Margin="0,0,0,8" MouseDoubleClick="OnShortcutAdd"/>
                <TextBlock DockPanel.Dock="Top" Text="查询字段" FontWeight="Bold" Margin="2,0,0,4"/>
                <ListBox x:Name="LstField" SelectionChanged="OnFieldChanged"/>
            </DockPanel>
            <!-- 右：条件录入 + 条件行 -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="已选条件（双击行删除）" FontWeight="Bold" Margin="2,16,0,4"/>
                <ListBox x:Name="LstRows" Height="150" Margin="0,0,0,8" MouseDoubleClick="OnRowDelete"/>
                <Border DockPanel.Dock="Top" BorderBrush="#CCC" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="操作符" VerticalAlignment="Center" Width="56"/>
                            <ComboBox x:Name="CboOp" Width="90" Height="24"/>
                            <RadioButton x:Name="OptAnd" Content="且" IsChecked="True" Margin="24,0,4,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="OptOr" Content="或" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <Button Content="加入条件" Width="80" Height="24" Click="OnAdd"/>
                        </StackPanel>
                        <StackPanel x:Name="PnlText" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="值" VerticalAlignment="Center" Width="56"/>
                            <TextBox x:Name="TxtValue" Width="220" Height="24"/>
                        </StackPanel>
                        <StackPanel x:Name="PnlNum" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                            <TextBlock Text="值" VerticalAlignment="Center" Width="56"/>
                            <TextBox x:Name="TxtNum" Width="220" Height="24"/>
                        </StackPanel>
                        <StackPanel x:Name="PnlDate" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                            <TextBlock Text="起" VerticalAlignment="Center" Width="56"/>
                            <DatePicker x:Name="Dp1" Width="110" Margin="0,0,8,0"/>
                            <TextBlock Text="止" VerticalAlignment="Center"/>
                            <DatePicker x:Name="Dp2" Width="110" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LblHint" Foreground="#888" Margin="0,2,0,0"
                                   Text="快捷条件：双击直接加入（操作符/值禁用）"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
