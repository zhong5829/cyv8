<UserControl x:Class="QPGL.Desktop.Views.OrderBudControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <!-- 生成订单表单条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="订单号" VerticalAlignment="Center"/>
                    <TextBox Width="110" Text="{Binding Cno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="订单日期" VerticalAlignment="Center"/>
                    <DatePicker Width="120" SelectedDate="{Binding OrderDate}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="订货公式" VerticalAlignment="Center"/>
                    <ComboBox Width="190" ItemsSource="{Binding Formulas}" SelectedItem="{Binding SelectedFormula}"
                              DisplayMemberPath="Expna" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="订货依据" VerticalAlignment="Center"/>
                    <ComboBox Width="130" ItemsSource="{Binding ComboTypes}" SelectedItem="{Binding SelectedComboType}"
                              DisplayMemberPath="Name" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="供应商" VerticalAlignment="Center"/>
                    <TextBox Width="130" Text="{Binding Gyname, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <Button Content="生成订单" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GenerateCommand}" Margin="0,0,12,0"/>
                    <TextBlock Text="厂牌" VerticalAlignment="Center"/>
                    <TextBox Width="80" Text="{Binding Cp, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="进库起止" VerticalAlignment="Center"/>
                    <DatePicker Width="110" SelectedDate="{Binding InDate1}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <DatePicker Width="110" SelectedDate="{Binding InDate2}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="出库起止" VerticalAlignment="Center"/>
                    <DatePicker Width="110" SelectedDate="{Binding Date1}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <DatePicker Width="110" SelectedDate="{Binding Date2}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="P02起始月" VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding BMon, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBlock Text="结束月" VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding EMon, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="车型" VerticalAlignment="Center"/>
                    <TextBox Width="90" Text="{Binding Ty, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                    <CheckBox Content="排除" IsChecked="{Binding TyExclude}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="产地" VerticalAlignment="Center"/>
                    <TextBox Width="70" Text="{Binding Dc, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="库存区间" VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding BAmt, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                    <TextBlock Text="~" VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding EAmt, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 提示条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="当前厂牌：" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Cp}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 既有计划单列表 -->
        <TextBlock DockPanel.Dock="Top" Text="既有计划单列表" FontWeight="Bold" Margin="2,0,0,4"/>
        <DataGrid ItemsSource="{Binding OrderNos}" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="订单号" Binding="{Binding Cno}" IsReadOnly="True" Width="160"/>
                <DataGridTextColumn Header="订单日期" Binding="{Binding Orderdate}" IsReadOnly="True" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
