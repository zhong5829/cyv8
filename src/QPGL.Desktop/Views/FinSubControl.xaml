<UserControl x:Class="QPGL.Desktop.Views.FinSubControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增科目" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
                <Button Content="删除科目" Command="{Binding DeleteCommand}" Margin="8,0,0,0"
                        ToolTip="有下级/凭证引用时余额上移上级科目（finsub row2 契约）"/>
                <Button Content="刷新" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12" IsReadOnly="True"
                  SelectedItem="{Binding SelectedRow}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="科目代码" Binding="{Binding Subcode}" Width="110"/>
                <DataGridTextColumn Header="科目名称" Binding="{Binding Subname}" Width="*"/>
                <DataGridTextColumn Header="类别" Binding="{Binding Type}" Width="50"/>
                <DataGridTextColumn Header="方向" Binding="{Binding Fdc}" Width="50"/>
                <DataGridCheckBoxColumn Header="现金类" Binding="{Binding Fcash}" Width="60"/>
                <DataGridCheckBoxColumn Header="明细" Binding="{Binding Detacode}" Width="50"/>
                <DataGridTextColumn Header="期初借" Binding="{Binding Bdesum, StringFormat=N2}" Width="85" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="期初贷" Binding="{Binding Bcresum, StringFormat=N2}" Width="85" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="本期借" Binding="{Binding Cdesum, StringFormat=N2}" Width="85" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="本期贷" Binding="{Binding Ccresum, StringFormat=N2}" Width="85" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="年末借" Binding="{Binding Ydesum, StringFormat=N2}" Width="85" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="年末贷" Binding="{Binding Ycresum, StringFormat=N2}" Width="85" ElementStyle="{StaticResource NumCellRight}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
