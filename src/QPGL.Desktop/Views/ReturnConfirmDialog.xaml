<Window x:Class="QPGL.Desktop.Views.ReturnConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认退货" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackBrush}">
    <StackPanel Margin="14">
        <Border BorderBrush="#A0A0A0" BorderThickness="1" Padding="12,10" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="单　　号:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPaper" Grid.Row="0" Grid.Column="1" IsReadOnly="True"
                         Background="#DAE9F5" VerticalContentAlignment="Center" Margin="8,2,0,2"/>

                <TextBlock Grid.Row="1" Text="发 票 号:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtInvoice" Grid.Row="1" Grid.Column="1"
                         VerticalContentAlignment="Center" Margin="8,2,0,2"/>

                <TextBlock Grid.Row="2" Text="退款方式:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbRefund" Grid.Row="2" Grid.Column="1"
                          VerticalContentAlignment="Center" Margin="8,2,0,2"/>

                <TextBlock Grid.Row="3" Text="退货原因:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbReason" Grid.Row="3" Grid.Column="1" IsEditable="True"
                          VerticalContentAlignment="Center" Margin="8,2,0,2"/>

                <TextBlock Grid.Row="4" Text="发货方式:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbShip" Grid.Row="4" Grid.Column="1"
                          VerticalContentAlignment="Center" Margin="8,2,0,2"/>

                <TextBlock Grid.Row="5" Text="销售类型:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbPaperType" Grid.Row="5" Grid.Column="1"
                          VerticalContentAlignment="Center" Margin="8,2,0,2"/>
            </Grid>
        </Border>

        <TextBlock x:Name="TxtError" Foreground="{StaticResource WarnBrush}" FontWeight="Bold"
                   Margin="0,6,0,0" Visibility="Collapsed"/>

        <CheckBox x:Name="ChkPrintAfter" Content="确认后立即打印" IsChecked="True"
                  HorizontalAlignment="Center" Margin="0,10,0,2"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Content="确认" Width="86" Height="28" Margin="4,0"
                    Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="取消" Width="86" Height="28" Margin="4,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
