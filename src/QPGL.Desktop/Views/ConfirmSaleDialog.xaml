<Window x:Class="QPGL.Desktop.Views.ConfirmSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="整单确认" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackBrush}">
    <StackPanel Margin="14">

        <!-- 单号 + 客户额度/预警/余额（右列，旧系统红色/蓝色标签） -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="出库单号:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtPaper" Grid.Column="1" Margin="6,3" IsReadOnly="True"
                     Background="#E8F4FF" FontWeight="Bold"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock Text="客户限额: " Foreground="Red"/>
                    <TextBlock x:Name="TxtXede" Text="0" Foreground="Red" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock Text="预 警 限 额: " Foreground="Red"/>
                    <TextBlock x:Name="TxtYjxe" Text="0" Foreground="Red" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock Text="客户余额: " Foreground="Blue"/>
                    <TextBlock x:Name="TxtYue" Text="0" Foreground="Blue" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="客户号:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtGno" Grid.Column="1" Margin="6,3" Background="#E8F4FF"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="客户名称:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtGname" Grid.Column="1" Margin="6,3" Background="#E8F4FF" LostFocus="TxtGname_LostFocus"/>
        </Grid>

        <Separator Margin="0,2,0,8"/>

        <!-- 支付方式 / 优惠类型 -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="支付方式:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CboGuno" Grid.Column="1" Margin="6,2" MinHeight="24"/>
            <TextBlock Text="优惠类型:" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <ComboBox x:Name="CboYhlType" Grid.Column="3" Margin="6,2" MinHeight="24" SelectedIndex="0">
                <ComboBoxItem Content="整单优惠率"/>
                <ComboBoxItem Content="整单折让"/>
                <ComboBoxItem Content="整单上浮"/>
            </ComboBox>
        </Grid>

        <!-- 发票号 / 优惠率 -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="发票号:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtFphs" Grid.Column="1" Margin="6,2" Text="*"/>
            <TextBlock Text="优惠率:" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,2">
                <TextBox x:Name="TxtYhl" Width="60" Text="0.0000" HorizontalContentAlignment="Right"/>
                <TextBlock Text=" % 计算" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 发货方式 / 出库日期 -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="发货方式:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CboFhfs" Grid.Column="1" Margin="6,2" MinHeight="24" IsEditable="True"/>
            <TextBlock Text="出库日期:" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <DatePicker x:Name="DpOutdate" Grid.Column="3" Margin="6,2"/>
        </Grid>

        <!-- 销售类型 / 物流公司名 -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="销售类型:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CboXslx" Grid.Column="1" Margin="6,2" MinHeight="24" IsEditable="True"/>
            <TextBlock Text="物流公司名:" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox x:Name="TxtWlgs" Grid.Column="3" Margin="6,2"/>
        </Grid>

        <!-- 备注 -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="备注:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtRemark" Grid.Column="1" Margin="6,2"/>
        </Grid>

        <Separator Margin="0,2,0,8"/>

        <!-- 优惠前后应收金额 -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="优惠前应收总金额:" VerticalAlignment="Center" Foreground="Blue"/>
            <TextBox x:Name="TxtAmountBefore" Grid.Column="1" Margin="6,2" IsReadOnly="True"
                     Background="#E8F4FF" HorizontalContentAlignment="Right" Text="0.00"/>
        </Grid>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="优惠后应收总金额:" VerticalAlignment="Center" Foreground="Blue"/>
            <TextBox x:Name="TxtAmountAfter" Grid.Column="1" Margin="6,2" IsReadOnly="True"
                     Background="#E8F4FF" HorizontalContentAlignment="Right" Text="0.00"/>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="确 定" Width="90" Height="28" Margin="0,0,20,0" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="BtnOk_Click"/>
            <Button Content="取 消" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
