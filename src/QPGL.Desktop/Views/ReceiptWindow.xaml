<Window x:Class="QPGL.Desktop.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="500" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主区：左列（实售金额 + 收款方式/金额表），右列（单据金额与收款要素） -->
        <Grid Grid.Row="0" IsEnabled="{Binding CanConfirm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左列：实售金额 + 收款方式/金额（旧 fr_sk C_GUNO 表；多行可编辑，双击进入编辑） -->
            <StackPanel Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="实售金额：" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="4,2,0,2" IsReadOnly="True"
                             Background="#E8F4FF" Foreground="#C2185B" FontWeight="Bold"
                             FontFamily="{StaticResource NumFontFamily}" HorizontalContentAlignment="Right"
                             Text="{Binding TotalOprct, Mode=OneWay, StringFormat=N2}"
                             ToolTip="旧 TAMT：Σ ckamount*oprct*(100-yhl)/100，先求和再取 2 位"/>
                </Grid>
                <Border Margin="0,8,0,0" Width="205" HorizontalAlignment="Left"
                        Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Background="{StaticResource BrandBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="123"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="收款方式" Foreground="White" FontWeight="Bold"
                                       Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="金额" Foreground="White" FontWeight="Bold"
                                       HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding PayTermRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="123"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Margin="6,0" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Height="22"
                                                     Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                     IsReadOnly="{Binding IsReadOnly, Mode=OneWay}" BorderThickness="0" Background="Transparent"
                                                     FontFamily="{StaticResource NumFontFamily}"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Padding="0,0,8,0"
                                                     PreviewMouseDoubleClick="PayAmount_MouseDoubleClick"
                                                     LostFocus="PayAmount_LostFocus"
                                                     ToolTip="双击进入编辑；失焦按旧口径压行并计算减收"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- 收款合计 + 差额提示（旧确认前 ΣPAYAMT vs TAMT 口径） -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="收款合计：" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="4,0,0,0" IsReadOnly="True"
                             Background="#E8F4FF" FontWeight="Bold"
                             FontFamily="{StaticResource NumFontFamily}" HorizontalContentAlignment="Right"
                             Text="{Binding PayTotal, Mode=OneWay, StringFormat=N2}"/>
                </Grid>
                <TextBlock Text="{Binding DifferenceText}" FontSize="10" Foreground="#B45309"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 右列：开单金额/客户欠款/减收/发票号/支付方式/发货方式/会员卡号/确认日期/备注/挂帐支付方 -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="开单金额：" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" IsReadOnly="True"
                         Background="#E8F4FF" Foreground="{StaticResource BrandBrush}" FontWeight="Bold"
                         FontFamily="{StaticResource NumFontFamily}" HorizontalContentAlignment="Right"
                         Text="{Binding TotalOprc, Mode=OneWay, StringFormat=N2}"/>

                <TextBlock Grid.Row="1" Text="客户欠款：" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" IsReadOnly="True"
                         Background="#E8F4FF" Foreground="{StaticResource BrandBrush}" FontWeight="Bold"
                         FontFamily="{StaticResource NumFontFamily}" HorizontalContentAlignment="Right"
                         Text="{Binding CustomerYue, Mode=OneWay, StringFormat=N2}"
                         ToolTip="客户应收余额 Σ(ys-yf)，只读"/>

                <TextBlock Grid.Row="2" Text="减收：" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" IsReadOnly="True"
                         Background="#F5F5F5" FontFamily="{StaticResource NumFontFamily}"
                         HorizontalContentAlignment="Right"
                         Text="{Binding Jianshou, Mode=OneWay, StringFormat=F2}"
                         ToolTip="旧 TEXT2（Enabled=.F.）：减收 = 限额 − 收款合计；挂帐/托收/汇款限额取开单金额，其余取实售金额；超额时把当前行压回限额并归 0"/>

                <TextBlock Grid.Row="3" Text="发票号：" VerticalAlignment="Center"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding PnoPrefixOptions}" SelectedItem="{Binding PnoPrefix, Mode=TwoWay}"
                              Margin="0,0,4,0" MinHeight="24"
                              ToolTip="旧 CBO_PNO：写 tbsada.pno 首位。* = 默认（发票附单）；Y = 开票（按开票系数价，打印税额拆分）；N = 不开票（出库清单）"/>
                    <TextBox Grid.Column="1" Text="{Binding PayNo, Mode=TwoWay}"
                             ToolTip="发票号本体（旧 TXTPAYNO）；确认时与前缀拼接写入 tbsada.pno"/>
                </Grid>

                <TextBlock Grid.Row="4" Text="支付方式：" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,2" MinHeight="24"
                          ItemsSource="{Binding PayTerms}" SelectedItem="{Binding SelectedPayTerm}"/>

                <TextBlock Grid.Row="5" Text="发货方式：" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,2" MinHeight="24" IsEditable="True"
                          ItemsSource="{Binding TModeOptions}"
                          Text="{Binding TMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="字典 tbsysset type='fhfs'；确认时写回 tbsada.t_mode"/>

                <TextBlock Grid.Row="6" Text="会员卡号：" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,2" IsEnabled="False"
                         ToolTip="截图字段：新系统暂无会员/积分模块，待确认"/>

                <TextBlock Grid.Row="7" Text="确认日期：" VerticalAlignment="Center"/>
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,2" IsReadOnly="True"
                         Background="#E8F4FF" Text="{Binding ConfirmDate, Mode=OneWay}"
                         ToolTip="仓储按 GETDATE() 写 qrdate，此处只读显示当前时间"/>

                <TextBlock Grid.Row="8" Text="备注：" VerticalAlignment="Center"/>
                <TextBox Grid.Row="8" Grid.Column="1" Margin="0,2" Text="{Binding Remark}"/>

                <TextBlock Grid.Row="9" Text="挂帐支付方：" VerticalAlignment="Center"/>
                <Grid Grid.Row="9" Grid.Column="1" Margin="0,2">
                    <TextBox x:Name="PayerBox"
                             Text="{Binding Payer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding PayerEnabled}"
                             IsReadOnly="{Binding IsPayerReadOnly}"
                             TextChanged="PayerBox_TextChanged"
                             PreviewKeyDown="PayerBox_PreviewKeyDown"
                             LostFocus="PayerBox_LostFocus">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#EDF7ED"/>
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.ToolTip>系统开关「启用挂账支付方」（tbcskg）开启时可输入/查找客户档案（tbgu.gname）；
挂账且非空时替代客户名写 tbysyf.gname / tbfpgl.gname；与客户名相同按客户名处理；无列可回显，确认后重开为空</TextBox.ToolTip>
                    </TextBox>
                    <Popup x:Name="PayerPopup" StaysOpen="False" AllowsTransparency="True"
                           PlacementTarget="{Binding ElementName=PayerBox}" Placement="Bottom"
                           Width="{Binding ActualWidth, ElementName=PayerBox}">
                        <Border Background="White" BorderBrush="#C9CDD4" BorderThickness="1"
                                MaxHeight="180" Margin="0,2,0,0">
                            <ListBox x:Name="PayerList" BorderThickness="0"
                                     ItemsSource="{Binding PayerSuggestions}"
                                     MouseLeftButtonUp="PayerList_MouseLeftButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2">
                                            <TextBlock Text="{Binding PartName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PartNo}" FontSize="10" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

            </Grid>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{StaticResource WarnBrush}"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>

        <!-- 底部：口径提示（不显眼）+ 确定/取消 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="提示：减收=限额−收款合计（挂帐/托收/汇款取开单金额，其余取实售金额）；仅「挂帐」写入应收应付。"
                       FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="确 定" Width="86" Height="28" IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCommand}"/>
                <Button Content="取 消" Width="86" Height="28" Margin="10,0,0,0" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
