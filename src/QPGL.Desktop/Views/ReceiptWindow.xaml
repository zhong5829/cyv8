<Window x:Class="QPGL.Desktop.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收款确认" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource WindowBackBrush}">
    <DockPanel Margin="14">
        <!-- 单据信息 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="单号：" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Paper}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="日期："/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Outdate, StringFormat=yyyy-MM-dd}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="客户："/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gname}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="已收："/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding MarkText}" Foreground="{StaticResource WarnBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="原价合计："/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalOprc, StringFormat=N2}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="实收合计："/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TotalOprct, StringFormat=N2}" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- 输入区（旧 fr_sk 窗：付款方式/实收/票据号/备注） -->
        <Grid DockPanel.Dock="Top" IsEnabled="{Binding CanConfirm}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="付款方式：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding PayTerms}" SelectedItem="{Binding SelectedPayTerm}"
                      VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="实收金额：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,0,8" FontFamily="{StaticResource NumFontFamily}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="票据号：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PayNo}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="备注：" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Remark}" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <!-- 按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确认收款" Command="{Binding ConfirmCommand}" Padding="22,5" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="取消" Command="{Binding CancelCommand}" Padding="22,5"/>
        </StackPanel>
    </DockPanel>
</Window>
