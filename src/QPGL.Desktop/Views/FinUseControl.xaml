<UserControl x:Class="QPGL.Desktop.Views.FinUseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <StackPanel Margin="16" VerticalAlignment="Center" MaxWidth="560">
        <TextBlock Text="启用帐套" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="启用前校验一级科目期初平衡；启用时清空凭证/账簿并快照初始科目余额，帐套进入正式使用状态。"/>
        <Button Content="启用帐套" Command="{Binding EnableCommand}" Padding="16,5" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource BrandBrush}" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
