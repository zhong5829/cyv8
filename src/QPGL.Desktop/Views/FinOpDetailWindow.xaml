<Window x:Class="QPGL.Desktop.Views.FinOpDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="820" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource WindowBackBrush}" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" FontWeight="Bold" Margin="0,0,0,8"/>
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="客户/供应商" Binding="{Binding Gu}" Width="140"/>
                <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="90"/>
                <DataGridTextColumn Header="单号" Binding="{Binding Paper}" Width="100"/>
                <DataGridTextColumn Header="编号" Binding="{Binding Nno}" Width="110"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="160"/>
                <DataGridTextColumn Header="车型" Binding="{Binding Ty}" Width="100"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Amount, StringFormat=N2}" Width="70" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="单价" Binding="{Binding Oprc, StringFormat=N2}" Width="80" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="金额" Binding="{Binding Oprct, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="优惠%" Binding="{Binding Yhl, StringFormat=N0}" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="付款方式" Binding="{Binding Pty}" Width="80"/>
                <DataGridTextColumn Header="营业员" Binding="{Binding Per}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold"/>
            <Button Content="关闭" Click="OnClose" Padding="18,4" IsCancel="True"/>
        </StackPanel>
    </DockPanel>
</Window>
