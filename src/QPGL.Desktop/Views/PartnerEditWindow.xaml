<Window x:Class="QPGL.Desktop.Views.PartnerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="客户资料" Height="430" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource WindowBackBrush}">
    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="客户号*：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Gno, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="优惠率：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Yhl, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="客户名称*：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Gname, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="通用单位*：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Name1, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="联系人：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Linkman, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" VerticalAlignment="Center" Margin="0,0,0,8" ToolTip="char(8)：最多 4 个汉字"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="业务员：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Ywy, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="电话：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Tel, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="手机：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="地址：" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Adr, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" VerticalAlignment="Center" Margin="0,0,0,8"/>
        </Grid>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                   ToolTip="通用单位=集团主客户名（=客户名称表示自身；否则须已存在同名主客户）"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="保存" Command="{Binding SaveCommand}" Padding="22,5" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="取消" Click="OnCancel" Padding="22,5"/>
        </StackPanel>
    </DockPanel>
</Window>
