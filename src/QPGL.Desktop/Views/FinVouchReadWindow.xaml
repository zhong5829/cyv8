<Window x:Class="QPGL.Desktop.Views.FinVouchReadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="读凭证" Width="720" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource WindowBackBrush}" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="凭证字：" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Vouword}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBlock Grid.Column="2" Text="{Binding Header}" VerticalAlignment="Center"/>
            <Button Grid.Column="3" Content="◀ 上一张" Click="OnPrio" Padding="10,3" Margin="0,0,6,0"/>
            <Button Grid.Column="4" Content="下一张 ▶" Click="OnNext" Padding="10,3" Margin="0,0,12,0"/>
            <Button Grid.Column="5" Content="打印" Click="OnPrint" Padding="10,3"
                    ToolTip="fr_finvprint 六选一版式 + finvprn 每页行数"/>
        </Grid>
        <DataGrid x:Name="Grid" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="录" Binding="{Binding Recoid}" Width="40"/>
                <DataGridTextColumn Header="摘要" Binding="{Binding Note}" Width="*"/>
                <DataGridTextColumn Header="科目" Binding="{Binding Subcode}" Width="100"/>
                <DataGridTextColumn Header="科目名" Binding="{Binding Subname}" Width="180"/>
                <DataGridTextColumn Header="借方" Binding="{Binding Debit, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="贷方" Binding="{Binding Credit, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumCellRight}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="{Binding Totals}" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold"/>
            <Button Content="关闭" Click="OnClose" Padding="18,4" IsCancel="True"/>
        </StackPanel>
    </DockPanel>
</Window>
