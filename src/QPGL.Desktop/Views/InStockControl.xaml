<UserControl x:Class="QPGL.Desktop.Views.InStockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QPGL.Desktop.Views">
    <UserControl.Resources>
        <local:NegativeQtyConverter x:Key="NegQty"/>
        <!-- 进货退货行（数量为负）整行红字，与订单生成页 Order4Control / 销售编辑窗 HistoryRowStyle 同口径 -->
        <Style x:Key="PurchaseHistoryRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Qty, Converter={StaticResource NegQty}}" Value="True">
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <!-- 单头信息 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="合同单号" VerticalAlignment="Center"/>
                <TextBox Width="120" Text="{Binding Cno, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"
                         VerticalAlignment="Center" Margin="4,0,12,0"
                         ToolTip="生效入库时自动生成（GETNEWDH 散件入库单）；如旧系统「是否自动合同号」开启则人工输入"/>
                <TextBlock Text="供应商" VerticalAlignment="Center"/>
                <!-- 供应商联想下拉（旧 cmm_class FRDM 机制：拼音码 code/数字码 code1/名称/编号前缀匹配） -->
                <Grid Margin="4,0,12,0">
                    <TextBox x:Name="GynameBox" Width="130" Text="{Binding Gyname, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" TextChanged="GynameBox_TextChanged" PreviewKeyDown="GynameBox_PreviewKeyDown"/>
                    <Popup x:Name="GysPopup" PlacementTarget="{Binding ElementName=GynameBox}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" MinWidth="320">
                        <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                CornerRadius="3" Margin="0,2,8,8" SnapsToDevicePixels="True">
                            <ListBox x:Name="GysList" ItemsSource="{Binding SupplierSuggestions}"
                                     MaxHeight="400" BorderThickness="0"
                                     MouseLeftButtonUp="GysList_MouseLeftButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Gyno}" Width="90" Foreground="#666"/>
                                            <TextBlock Text="{Binding Gyname}" Width="180"/>
                                            <TextBlock Text="{Binding Linkman}" Foreground="#888"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <TextBlock Text="票据号" VerticalAlignment="Center"/>
                <TextBox Width="100" Text="{Binding Pno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="付款方式*" VerticalAlignment="Center"/>
                <ComboBox Width="90" ItemsSource="{Binding PayTerms}" SelectedItem="{Binding Fkfs}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="业务员" VerticalAlignment="Center"/>
                <ComboBox Width="90" ItemsSource="{Binding Operators}" SelectedItem="{Binding Ywr}"
                          IsEditable="True" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <!-- 切换暂存单（2026-11-02 需求）：重开未生效暂存单选择窗，恢复另一张暂存单 -->
                <Button Content="暂存单..." Click="SwitchDraftButton_Click" Padding="10,3" Margin="12,0,0,0"
                        ToolTip="打开未生效暂存单列表，切换恢复另一张暂存单"/>
            </StackPanel>
        </Border>

        <!-- 工具条 -->
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="添加配件" Click="AddPartButton_Click" Padding="14,3" Margin="0,0,8,0"
                        ToolTip="弹出配件选择窗口（三条件查询），双击配件后设置数量/价格等入库信息"/>
                <Button Content="表格导入" Click="ImportButton_Click" Padding="14,3" Margin="0,0,8,0"
                        ToolTip="导入采集器 CSV（列：条码、数量）；按条码合计，属性库带出名称与进价（不含税价与含税价同额，不按税率换算）"/>
                <Button Content="删除行" Command="{Binding RemoveLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <!-- 保存暂存（2026-11-02 需求）：明细写 tbistosm 不入库，重开页面可恢复 -->
                <Button Content="保存暂存" Command="{Binding SaveDraftCommand}" Padding="14,3" Margin="0,0,8,0"
                        ToolTip="暂存当前明细（不更新库存），重开页面/软件后可恢复继续"/>
                <Button Content="生效入库" Command="{Binding SaveCommand}" Padding="20,3" FontWeight="Bold" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding TotalAmount, StringFormat=总进价金额：{0:N2}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/>
                <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" Margin="16,0,0,0"><Run Text="总进货数量："/><Run Text="{Binding TotalQty, Converter={StaticResource QtyInt}}"/></TextBlock>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主体（2026-11-07 需求）：左=入库明细，右=进货历史（选中明细行即刷新，GridSplitter 可拖动） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="0.6*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- 明细行（可编辑；2026-10-29 需求：双击行弹入库编辑窗修改该行；2026-11-02 需求：Del 键删除选中行） -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" FontSize="12" MouseDoubleClick="Lines_MouseDoubleClick"
                      PreviewKeyDown="Lines_PreviewKeyDown" CellEditEnding="Lines_CellEditEnding">
                <DataGrid.Columns>
                    <!-- 2026-11-07 需求：移除分类码/产地/单位/货位/仓库/备注六列（仅显示层，字段录入与落库仍走行编辑弹窗）；
                         原「备注」承担 * 填充，移除后由「名称」列接管，避免右侧留白 -->
                    <DataGridTextColumn Header="厂牌" Binding="{Binding Cp, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="零件号*" Binding="{Binding Nno, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    <DataGridTextColumn Header="名称*" Binding="{Binding Na1, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="车型" Binding="{Binding Ty, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="数量*" Binding="{Binding Jkamount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource QtyInt}}" Width="60"/>
                    <DataGridTextColumn Header="进价(含税)" Binding="{Binding Iprj, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                    <DataGridTextColumn Header="进价(不含税)" Binding="{Binding Iprc, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="售价" Binding="{Binding Oprc, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="批发价" Binding="{Binding Oprb, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

            <!-- 进货历史（2026-11-07 需求）：选中明细行对应配件；查询口径/列/负数量红字/空态与订单生成页完全同源 -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="进货历史（选中明细配件）" FontWeight="Bold" Margin="2,0,0,4"/>
                <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <DataGrid x:Name="PurchaseHistoryGrid" ItemsSource="{Binding PurchaseHistory}" RowStyle="{StaticResource PurchaseHistoryRowStyle}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" FontSize="12" Margin="1" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="单号" Binding="{Binding Cno}" IsReadOnly="True" Width="90"/>
                                <DataGridTextColumn Header="日期" Binding="{Binding InDate, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="82"/>
                                <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="数量" Binding="{Binding Qty, Mode=OneWay, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="50"
                                                    ElementStyle="{StaticResource NumCellRight}"/>
                                <DataGridTextColumn Header="进价(含税)" Binding="{Binding Iprj, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="85"
                                                    ElementStyle="{StaticResource NumCellRight}"/>
                                <DataGridTextColumn Header="进价(不含税)" Binding="{Binding Iprc, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="75"
                                                    ElementStyle="{StaticResource NumCellRight}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- 空态/加载/错误提示：未选中配件或该配件无进货记录时显示，避免空白区 -->
                        <TextBlock Text="{Binding PurchaseHistoryHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#888" TextWrapping="Wrap" TextAlignment="Center" Margin="12" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PurchaseHistoryHint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
