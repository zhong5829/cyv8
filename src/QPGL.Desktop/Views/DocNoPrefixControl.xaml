<UserControl x:Class="QPGL.Desktop.Views.DocNoPrefixControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="修改前缀" Command="{Binding UpdatePrefixCommand}" Padding="14,4" Margin="0,0,8,0"/>
                <Button Content="刷新" Command="{Binding SearchCommand}" Padding="14,4" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center"/>
                <TextBlock Text="    单号 = 前缀 + 年份后2位 + 6位流水（getnewdh）" Foreground="#666" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                  IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="单据类型" Binding="{Binding Djname}" Width="140"/>
                <DataGridTextColumn Header="前缀" Binding="{Binding Djjx}" Width="70"/>
                <DataGridTextColumn Header="当前流水" Binding="{Binding Lsh}" Width="100"/>
                <DataGridTextColumn Header="年份" Binding="{Binding Dyear}" Width="80"/>
                <DataGridTextColumn Header="部门" Binding="{Binding Dpm}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
