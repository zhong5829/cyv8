<UserControl x:Class="QPGL.Desktop.Views.FinCaforwControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <StackPanel Margin="16" VerticalAlignment="Center" MaxWidth="520">
        <TextBlock Text="结转损益" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Text="将当前会计期间损益类科目余额结转至本年利润（生成结转凭证后请过帐）。" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="会计期间：" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Period}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Content="执行结转" Command="{Binding TransferCommand}" Padding="16,5" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource BrandBrush}" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
