<UserControl x:Class="QPGL.Desktop.Views.YsyfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <!-- 查询条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="客户" VerticalAlignment="Center"/>
                <!-- 客户输入：可编辑联想下拉（旧 cmm_class FRDM 机制：拼音码 code/数字码 code1/名称/编号前缀匹配） -->
                <Grid Margin="4,0,12,0">
                    <TextBox x:Name="GnameBox" Width="150" Text="{Binding GnameFilter, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" TextChanged="GnameBox_TextChanged" PreviewKeyDown="GnameBox_PreviewKeyDown"
                             ToolTip="支持拼音码/数字码/名称/编号联想，↓选择，回车确认"/>
                    <Popup x:Name="CustPopup" PlacementTarget="{Binding ElementName=GnameBox}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" MinWidth="320">
                        <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                CornerRadius="3" Margin="0,2,8,8" SnapsToDevicePixels="True">
                            <ListBox x:Name="CustList" ItemsSource="{Binding CustomerSuggestions}"
                                     MaxHeight="500" BorderThickness="0"
                                     MouseLeftButtonUp="CustList_MouseLeftButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding PartNo}" Width="70" Foreground="#666"/>
                                            <TextBlock Text="{Binding PartName}" Width="170"/>
                                            <TextBlock Text="{Binding LinkMan}" Width="70" Foreground="#888"/>
                                            <TextBlock Text="{Binding Mobile}" Foreground="#888"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <TextBlock Text="选项" VerticalAlignment="Center"/>
                <ComboBox Width="110" ItemsSource="{Binding Options}" SelectedItem="{Binding Option}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="发生日期" VerticalAlignment="Center"/>
                <DatePicker Width="105" SelectedDate="{Binding DateFrom}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBlock Text="~" VerticalAlignment="Center"/>
                <DatePicker Width="105" SelectedDate="{Binding DateTo}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="方式" VerticalAlignment="Center"/>
                <TextBox Width="80" Text="{Binding Fkfs, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Button Content="查询" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" VerticalAlignment="Center"/>
                <Button Content="添加客户" Command="{Binding AddCustomerCommand}" Padding="10,3" Margin="16,0,0,0"/>
                <Button Content="修改客户" Command="{Binding EditCustomerCommand}" Padding="10,3" Margin="6,0,0,0"/>
                <Button Content="删除客户" Command="{Binding DeleteCustomerCommand}" Padding="10,3" Margin="6,0,0,0"/>
                <Button Content="结账凭证" Command="{Binding TwelveMonthCommand}" Padding="10,3" Margin="16,0,0,0"
                        ToolTip="fr_ysyf_12y：前十二月应收应付及余额（需先选中客户）"/>
                <Button Content="业务明细" Command="{Binding ShowBizDetailCommand}" Padding="10,3" Margin="6,0,0,0"
                        ToolTip="YWMX：销售/调拨→出库明细、入库→入库明细、收/付款→收付款单明细（需先选中明细行）"/>
            </StackPanel>
        </Border>

        <!-- 汇总条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="    明细操作：" VerticalAlignment="Center"/>
                <Button Content="添加明细" Command="{Binding AddDetailCommand}" Padding="10,3" Margin="4,0,6,0"/>
                <Button Content="修改明细" Command="{Binding EditDetailCommand}" Padding="10,3" Margin="0,0,6,0"/>
                <Button Content="删除明细" Command="{Binding DeleteDetailCommand}" Padding="10,3" Margin="0,0,6,0"/>
                <Button Content="多条删除" Command="{Binding MultiDeleteCommand}" Padding="10,3"
                        ToolTip="删除当前行之前的所有明细，当前行归并为汇总行（datime=1900-01-01）"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" ItemsSource="{Binding Summaries}" AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12" IsReadOnly="True"
                      SelectedItem="{Binding SelectedSummary}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="客户" Binding="{Binding Gname}" Width="*"/>
                    <DataGridTextColumn Header="应收" Binding="{Binding SYs, StringFormat=N2}" Width="95" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="应付" Binding="{Binding SYf, StringFormat=N2}" Width="95" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="余额" Binding="{Binding Lj, StringFormat=N2}" Width="95" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="余款" Binding="{Binding Cb, StringFormat=N2}" Width="80" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="可挂帐余额" Binding="{Binding Gzye, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="业务员" Binding="{Binding Ywy}" Width="70"/>
                    <DataGridTextColumn Header="财负责人" Binding="{Binding Cwfzr}" Width="70"/>
                    <DataGridTextColumn Header="最近收款" Binding="{Binding Mindate, StringFormat=yyyy-MM-dd}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDD"/>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Details}" AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12" IsReadOnly="True"
                      SelectedItem="{Binding SelectedDetail}" MouseDoubleClick="Details_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日期" Binding="{Binding Datime, StringFormat=yyyy-MM-dd}" Width="85"/>
                    <DataGridTextColumn Header="单据号" Binding="{Binding Cno}" Width="130"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="60"/>
                    <DataGridTextColumn Header="项目" Binding="{Binding Xm}" Width="*"/>
                    <DataGridTextColumn Header="应收" Binding="{Binding Ys, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="应付" Binding="{Binding Yf, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="累计" Binding="{Binding Lj, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="已收" Binding="{Binding Skmoney, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="方式" Binding="{Binding Fkfs}" Width="70"/>
                    <DataGridTextColumn Header="发票号" Binding="{Binding Pno}" Width="100"/>
                    <DataGridTextColumn Header="操作员" Binding="{Binding Per}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
