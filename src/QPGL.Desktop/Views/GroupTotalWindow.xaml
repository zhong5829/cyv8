<Window x:Class="QPGL.Desktop.Views.GroupTotalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据汇总" Width="336" Height="261" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="136"/>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="136"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="可选字段" Foreground="Blue" Margin="2,0,0,4"/>
            <ListBox x:Name="Lst1" Height="185" MouseDoubleClick="Lst1_DoubleClick"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="4,30,0,0">
            <Button Content=">>" Height="30" Click="BtnAddAll_Click"/>
            <Button Content=">" Height="30" Margin="0,6,0,0" Click="BtnAdd_Click"/>
            <Button Content="&lt;" Height="30" Margin="0,6,0,0" Click="BtnRemove_Click"/>
            <Button Content="&lt;&lt;" Height="30" Margin="0,6,0,0" Click="BtnRemoveAll_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="统计字段" Foreground="Red" Margin="2,0,0,4"/>
            <ListBox x:Name="Lst2" Height="185" MouseDoubleClick="Lst2_DoubleClick"/>
        </StackPanel>
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,8,0,0">
            <Button Content="确定" Width="44" Height="30" Margin="0,0,52,0" Click="BtnOk_Click"/>
            <Button Content="退出" Width="44" Height="30" Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>
