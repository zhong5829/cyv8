<UserControl x:Class="QPGL.Desktop.Views.PriceAdjustControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="仓库" VerticalAlignment="Center"/>
                <TextBox Width="60" Text="{Binding Depotno}" Margin="4,0,10,0"/>
                <Button Content="刷新库存" Command="{Binding LoadCommand}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}"/>
            </StackPanel>
        </Border>
        <!-- 页签行右侧：警戒值 A/B 含义说明（2026-11-04 需求） -->
        <Grid>
            <TabControl>
            <TabItem Header="库存调价（B4）">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" Padding="10,6" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="调价字段" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding FieldKind}" Width="90" Margin="4,0,10,0">
                                <ComboBoxItem Content="售价 oprc"/><ComboBoxItem Content="售价B oprb"/>
                                <ComboBoxItem Content="进价 iprc"/><ComboBoxItem Content="进价J iprj"/>
                            </ComboBox>
                            <TextBlock Text="=" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding BaseKind}" Width="90" Margin="4,0,6,0">
                                <ComboBoxItem Content="oprc"/><ComboBoxItem Content="iprj"/>
                                <ComboBoxItem Content="iprc"/><ComboBoxItem Content="oprb"/>
                            </ComboBox>
                            <TextBox Width="40" Text="{Binding Oper}" Margin="0,0,6,0"/>
                            <TextBox Width="70" Text="{Binding Factor}" Margin="0,0,10,0"/>
                            <TextBlock Text="取整" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding RoundMode}" Width="110" Margin="4,0,10,0">
                                <ComboBoxItem Content="不取整"/><ComboBoxItem Content="四舍五入 int+0.5"/><ComboBoxItem Content="进一 int+0.99"/>
                            </ComboBox>
                            <CheckBox Content="供应商基准价" IsChecked="{Binding BySupplier}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="100" Text="{Binding Gyname}" ToolTip="供应商名称（基准价模式）" Margin="0,0,10,0"/>
                            <Button Content="执行整批调价" Command="{Binding AdjustCommand}" Padding="12,3"/>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding IstoRows}" SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                               HeadersVisibility="Column" AlternatingRowBackground="#F8F8EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编码" Binding="{Binding Nno}" Width="110"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Na1}" Width="*"/>
                            <DataGridTextColumn Header="库存" Binding="{Binding Kcamount, Converter={StaticResource QtyInt}}" Width="70"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                            <DataGridTextColumn Header="进价" Binding="{Binding Iprc, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="进价J" Binding="{Binding Iprj, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="售价" Binding="{Binding Oprc, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="产地" Binding="{Binding Dc}" Width="60"/>
                            <DataGridTextColumn Header="仓库" Binding="{Binding Depotno}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="警戒线设置（B5）">
                <!-- 2026-11-04 改版（QP11 库存预警同构）：手动逐行编辑双档警戒值，编辑即落库；
                     清单=未设警戒或已低于警戒的配件（库存升序），低库存行红字 -->
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="厂牌" VerticalAlignment="Center"/>
                            <TextBox Width="80" Text="{Binding Cp}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                            <TextBlock Text="编码" VerticalAlignment="Center"/>
                            <TextBox x:Name="JjCpBox" Width="110" Text="{Binding JjCpFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                     Margin="4,0,12,0" PreviewKeyDown="JjSearchBox_PreviewKeyDown" GotKeyboardFocus="JjSearchBox_GotFocus"/>
                            <TextBlock Text="名称" VerticalAlignment="Center"/>
                            <TextBox x:Name="JjNa1Box" Width="130" Text="{Binding JjNa1Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                     Margin="4,0,12,0" ToolTip="支持拼音码（tbname0）"
                                     PreviewKeyDown="JjSearchBox_PreviewKeyDown" GotKeyboardFocus="JjSearchBox_GotFocus"/>
                            <TextBlock Text="车型" VerticalAlignment="Center"/>
                            <TextBox x:Name="JjTyBox" Width="100" Text="{Binding JjTyFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                     Margin="4,0,12,0" PreviewKeyDown="JjSearchBox_PreviewKeyDown" GotKeyboardFocus="JjSearchBox_GotFocus"/>
                            <Button Content="重新加载" Command="{Binding LoadJjCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Message}" VerticalAlignment="Center"/>
                    </Border>
                    <DataGrid x:Name="JjGrid" ItemsSource="{Binding JjView}" SelectedItem="{Binding SelectedJjRow}"
                              IsReadOnly="False"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" FontSize="12"
                              CellEditEnding="JjGrid_CellEditEnding"
                              PreparingCellForEdit="JjGrid_PreparingCellForEdit"
                              PreviewKeyDown="JjGrid_PreviewKeyDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- 库存<A 黄字预警；<B 红字告急（红触发器在后覆盖黄） -->
                                    <DataTrigger Binding="{Binding IsYellow}" Value="True">
                                        <Setter Property="Foreground" Value="#DAA520"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRed}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编码" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="仓位" Binding="{Binding Posi}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True" Width="45"/>
                            <DataGridTextColumn Header="库存数量" Binding="{Binding Stock, Converter={StaticResource QtyInt}}" IsReadOnly="True" Width="70"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="警戒值A" Binding="{Binding Amjj, UpdateSourceTrigger=LostFocus, Converter={StaticResource QtyInt}}" Width="70"
                                                ElementStyle="{StaticResource NumCellRight}" EditingElementStyle="{StaticResource QtyCellEdit}"/>
                            <DataGridTextColumn Header="警戒值B" Binding="{Binding Bmjj, UpdateSourceTrigger=LostFocus, Converter={StaticResource QtyInt}}" Width="70"
                                                ElementStyle="{StaticResource NumCellRight}" EditingElementStyle="{StaticResource QtyCellEdit}"/>
                            <DataGridTextColumn Header="零售价" Binding="{Binding Oprc, StringFormat=N2}" IsReadOnly="True" Width="70"
                                                ElementStyle="{StaticResource NumCellRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            </TabControl>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0"
                       TextAlignment="Right" Foreground="#888"
                       Text="警戒值A＝预警阈值（库存 &lt; A → 黄字）；警戒值B＝告急阈值（库存 &lt; B → 红字，红优先）。两档独立，只填 A、B 留空即可"/>
        </Grid>
    </DockPanel>
</UserControl>
