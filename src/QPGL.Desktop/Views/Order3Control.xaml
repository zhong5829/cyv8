<UserControl x:Class="QPGL.Desktop.Views.Order3Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QPGL.Desktop.ViewModels"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <vm:OrderRowBrushConverter x:Key="RowBrush"/>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <!-- 查询条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="合同号" VerticalAlignment="Center"/>
                <TextBox Width="100" Text="{Binding Cno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="订单号" VerticalAlignment="Center"/>
                <TextBox Width="100" Text="{Binding Orno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="编号前缀" VerticalAlignment="Center"/>
                <TextBox Width="100" Text="{Binding NnoPrefix, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="名称" VerticalAlignment="Center"/>
                <TextBox Width="120" Text="{Binding Na1Contains, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="供应商" VerticalAlignment="Center"/>
                <TextBox Width="110" Text="{Binding Gyname, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="客户" VerticalAlignment="Center"/>
                <TextBox Width="100" Text="{Binding Gname, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="快捷" VerticalAlignment="Center"/>
                <ComboBox Width="80" ItemsSource="{Binding QuickOptions}" SelectedItem="{Binding SelectedQuick}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="厂牌" VerticalAlignment="Center"/>
                <TextBox Width="70" Text="{Binding Cp, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Button Content="查询" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
            </StackPanel>
        </Border>

        <!-- 工具条 -->
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增行" Command="{Binding AddLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="修改行" Command="{Binding EditLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="删除行" Command="{Binding DeleteLineCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="批改" Command="{Binding BatchCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="合并散单" Command="{Binding MergeCommand}" Padding="14,3" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 主网格 -->
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" FontSize="12">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{Binding Converter={StaticResource RowBrush}}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="单号" Binding="{Binding Cno}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="订单号" Binding="{Binding Orno}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="项号" Binding="{Binding Item, Mode=OneWay}" IsReadOnly="True" Width="45"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="库存" Binding="{Binding Kcamount, Mode=OneWay}" IsReadOnly="True" Width="60"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="订货数" Binding="{Binding Oqty, Mode=OneWay}" IsReadOnly="True" Width="60"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="已到" Binding="{Binding Qty, Mode=OneWay}" IsReadOnly="True" Width="55"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="外币价" Binding="{Binding Iprj, Mode=OneWay}" IsReadOnly="True" Width="60"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="厂家编码" Binding="{Binding Oenno}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="订货日期" Binding="{Binding Orderdate, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="85"/>
                <DataGridTextColumn Header="预计到货" Binding="{Binding Eta, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="85"/>
                <DataGridTextColumn Header="售价" Binding="{Binding Oprc, Mode=OneWay}" IsReadOnly="True" Width="60"
                                    ElementStyle="{StaticResource NumCellRight}"/>
                <DataGridTextColumn Header="业务员" Binding="{Binding Per}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="备注类型" Binding="{Binding Bzlx}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="产地" Binding="{Binding Fa}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True" Width="45"/>
                <DataGridTextColumn Header="付款方式" Binding="{Binding Fkfs}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="客户" Binding="{Binding Gname}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Nnp" Binding="{Binding Nnp}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="Nnq" Binding="{Binding Nnq}" IsReadOnly="True" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
