<Window x:Class="QPGL.Desktop.Views.LszTiquWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提取销售/入库" Width="720" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource WindowBackBrush}" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="RbSale" Content="销售" IsChecked="True" GroupName="kind" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="RbIn" Content="入库" GroupName="kind" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <TextBlock Text="从：" VerticalAlignment="Center"/>
            <DatePicker x:Name="DpFrom" Width="120" Margin="4,0,10,0"/>
            <TextBlock Text="至：" VerticalAlignment="Center"/>
            <DatePicker x:Name="DpTo" Width="120" Margin="4,0,10,0"/>
            <Button Content="查询" Padding="14,3" Click="OnReload"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="日期" Binding="{Binding Outdate, StringFormat=yyyy-MM-dd, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="单号" Binding="{Binding Paper, Mode=OneWay}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="金额" Binding="{Binding Jine, StringFormat=N2, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="客户/供应商" Binding="{Binding Gname, Mode=OneWay}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="去向" Binding="{Binding Guno, Mode=OneWay}" Width="90" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="全选" Click="OnCheckAll" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="确认提取" Click="OnOk" Padding="18,4" FontWeight="Bold" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="取消" Click="OnCancel" Padding="18,4" IsCancel="True"/>
        </StackPanel>
    </DockPanel>
</Window>
