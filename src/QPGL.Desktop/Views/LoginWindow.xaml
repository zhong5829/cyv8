<Window x:Class="QPGL.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="长远汽配管理系统 V8 - 登录"
        Width="460" Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- 品牌抬头 -->
        <Border Background="{StaticResource BrandBrush}">
            <StackPanel VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="长远汽配管理系统 V8" FontSize="19" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="新系统重构版 · 客户端直连数据库" FontSize="11" Foreground="#C7D6E8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Margin="24,14" CornerRadius="4"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <StackPanel Margin="24,14">
                <TextBlock Text="操作员" FontSize="12" Foreground="#555"/>
                <ComboBox x:Name="OperatorBox" Margin="0,3,0,10"
                          IsEditable="True"
                          ItemsSource="{Binding Operators}"
                          Text="{Binding SelectedOperator, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="密码" FontSize="12" Foreground="#555"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,3,0,4" PasswordChanged="PasswordBox_PasswordChanged"/>

                <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnBrush}" FontSize="12"
                           MinHeight="18" Margin="0,2,0,0" TextWrapping="Wrap"/>

                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Button Content="登 录 (Enter)" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoginCommand}" IsDefault="True"
                            Margin="0,0,5,0" Padding="0,8" FontSize="14"/>
                    <Button Content="取 消 (Esc)" Command="{Binding CancelCommand}" IsCancel="True"
                            Margin="5,0,0,0" Padding="0,8" FontSize="14"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BrandDarkBrush}">
            <TextBlock Text="直连模式（qp11 同款）· 连接配置见本机 appsettings.json · 库结构零改动"
                       Foreground="#9FB8D4" FontSize="11" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
