<UserControl x:Class="QPGL.Desktop.Views.PurchaseReturnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <DockPanel Margin="8">
        <!-- 模式切换条（2026-11-04 需求：双模式，F3/按钮切换） -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="切换模式 (F3)" Command="{Binding ToggleModeCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding CurrentModeText, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid>
            <!-- ============ 退货开单模式（原单模式） ============ -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQueryMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!-- 操作条 -->
                <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="删除退货行" Command="{Binding RemoveCartCommand}" Padding="14,3" Margin="0,0,8,0"/>
                        <Button Content="清空退货车" Command="{Binding ClearCartCommand}" Padding="14,3" Margin="0,0,16,0"/>
                        <TextBlock Text="供应商" VerticalAlignment="Center"/>
                        <!-- 供应商下拉联想（旧 cmm_class FRDM 机制：拼音码 code/数字码 code1/名称/编号前缀匹配）；选中后按供应商加载流水 -->
                        <Grid Margin="4,0,12,0">
                            <TextBox x:Name="GyBox" Width="110" VerticalAlignment="Center"
                                     Text="{Binding Gyname, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="GyBox_TextChanged" PreviewKeyDown="GyBox_PreviewKeyDown"
                                     GotFocus="GyBox_GotFocus"/>
                            <Popup x:Name="GyPopup" PlacementTarget="{Binding ElementName=GyBox}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" MinWidth="280">
                                <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                        CornerRadius="3" Margin="0,2,8,8" SnapsToDevicePixels="True">
                                    <ListBox x:Name="GyList" MaxHeight="300" BorderThickness="0"
                                             MouseLeftButtonUp="GyList_MouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <TextBlock Text="{Binding Gyno}" Width="70" Foreground="#666"/>
                                                    <TextBlock Text="{Binding Gyname}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                        <TextBlock Text="退货日期" VerticalAlignment="Center"/>
                        <DatePicker Width="110" SelectedDate="{Binding ReturnDate}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <TextBlock Text="退款方式" VerticalAlignment="Center"/>
                        <ComboBox Width="110" ItemsSource="{Binding FkfsOptions}" SelectedItem="{Binding SelectedFkfs}"
                                  VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <TextBlock Text="退货原因" VerticalAlignment="Center"/>
                        <ComboBox Width="110" ItemsSource="{Binding ReasonOptions}" SelectedItem="{Binding SelectedReason}"
                                  VerticalAlignment="Center" Margin="4,0,16,0"/>
                        <Button Content="确认退货" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCommand}" Padding="16,3"/>
                    </StackPanel>
                </Border>

                <!-- 查询条件条（旧简易查询窗 __.row144 字段子集，紧贴配件区域上方 2026-11-04 需求；实时防抖查询） -->
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6"
                        PreviewKeyDown="QueryBar_PreviewKeyDown">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="入库单号" VerticalAlignment="Center"/>
                        <TextBox x:Name="CnoBox" Width="110" Text="{Binding Cno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <TextBlock Text="配件编号" VerticalAlignment="Center"/>
                        <TextBox x:Name="NnoBox" Width="120" Text="{Binding NnoPrefix, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <TextBlock Text="名称" VerticalAlignment="Center"/>
                        <TextBox x:Name="Na1Box" Width="140" Text="{Binding Na1Prefix, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <TextBlock Text="车型" VerticalAlignment="Center"/>
                        <TextBox x:Name="TyBox" Width="110" Text="{Binding TyPrefix, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <TextBlock Text="入库日期" VerticalAlignment="Center"/>
                        <DatePicker Width="110" SelectedDate="{Binding InDateFrom}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBlock Text="~" VerticalAlignment="Center"/>
                        <DatePicker Width="110" SelectedDate="{Binding InDateTo}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <Button Content="查询" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 合计/消息条 -->
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="进价合计：" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalIprc, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 上：可退流水（ised） / 下：退货车（c_th） -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="LinesGrid" Grid.Row="0" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                              AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" FontSize="12"
                              MouseDoubleClick="LinesGrid_MouseDoubleClick" PreviewKeyDown="LinesGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="配件编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="原进库数" Binding="{Binding Oamount, StringFormat=F0}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="可退数" Binding="{Binding Amount, StringFormat=F0}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="当前库存" Binding="{Binding Kshu, StringFormat=F0}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="入库单号" Binding="{Binding Cno}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="库号" Binding="{Binding Depotno}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="仓位" Binding="{Binding Posi}" IsReadOnly="True" Width="55"/>
                            <DataGridTextColumn Header="进价" Binding="{Binding Iprc, StringFormat=F2}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="入库日期" Binding="{Binding Indate, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" IsReadOnly="True" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCart}"
                              AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" FontSize="12" PreviewKeyDown="CartGrid_PreviewKeyDown"
                              ContextMenuOpening="CartGrid_ContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <!-- 右键删除选中退货行（2026-11-04 需求） -->
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="删除退货行" Command="{Binding RemoveCartCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="配件编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="退库数" Binding="{Binding Amount, UpdateSourceTrigger=LostFocus}" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="进价" Binding="{Binding Iprc, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding DataContext.PriceLocked, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="库号" Binding="{Binding Depotno}" Width="55"/>
                            <DataGridTextColumn Header="仓位" Binding="{Binding Posi}" Width="55"/>
                            <DataGridTextColumn Header="原进库数" Binding="{Binding Oamount}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="当前库存" Binding="{Binding Kshu}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="原单号" Binding="{Binding Cno}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" IsReadOnly="True" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>

            <!-- ============ 单据查询模式（2026-11-04 需求：历史退货单据 + 明细） ============ -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQueryMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!-- 单据查询条件条（实时防抖） -->
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="退库单号" VerticalAlignment="Center"/>
                        <TextBox Width="120" Text="{Binding DocCno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <TextBlock Text="供应商" VerticalAlignment="Center"/>
                        <TextBox Width="120" Text="{Binding DocGyname, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <TextBlock Text="退货日期" VerticalAlignment="Center"/>
                        <DatePicker Width="110" SelectedDate="{Binding DocDateFrom}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBlock Text="~" VerticalAlignment="Center"/>
                        <DatePicker Width="110" SelectedDate="{Binding DocDateTo}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <Button Content="查询" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchDocsCommand}" VerticalAlignment="Center"/>
                        <Button Content="打印" Command="{Binding PrintDocsCommand}" Padding="14,3" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Button Content="导出表格" Command="{Binding ExportDocsCommand}" Padding="14,3" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 消息条 -->
                <Border DockPanel.Dock="Top" Padding="0,0,0,6">
                    <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center"/>
                </Border>

                <!-- 上：历史退货单据 / 下：选中单明细 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Docs}" SelectedItem="{Binding SelectedDoc}"
                              AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" FontSize="12" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="退库单号" Binding="{Binding Cno}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="退货日期" Binding="{Binding Indate, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="退款方式" Binding="{Binding Fkfs}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="经办人" Binding="{Binding Per}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="行数" Binding="{Binding LineCount, StringFormat=F0}" IsReadOnly="True" Width="55" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="退货数量" Binding="{Binding TotalAmount, StringFormat=F0}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource NumCellRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding DocLines}"
                              AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" FontSize="12" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="配件编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="车型" Binding="{Binding Ty}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="退库数" Binding="{Binding Amount, StringFormat=F0}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="外币价" Binding="{Binding Iprj, StringFormat=F2}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="进价" Binding="{Binding Iprc, StringFormat=F2}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                            <DataGridTextColumn Header="库号" Binding="{Binding Depotno}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="仓位" Binding="{Binding Posi}" IsReadOnly="True" Width="55"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" IsReadOnly="True" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
