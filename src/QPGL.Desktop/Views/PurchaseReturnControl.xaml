<UserControl x:Class="QPGL.Desktop.Views.PurchaseReturnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <!-- 查询条件条（旧简易查询窗 __.row144 字段子集） -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="�库单号" VerticalAlignment="Center"/>
                <TextBox Width="110" Text="{Binding Cno, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="�件编号" VerticalAlignment="Center"/>
                <TextBox Width="120" Text="{Binding NnoPrefix, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="名称" VerticalAlignment="Center"/>
                <TextBox Width="140" Text="{Binding Na1Prefix, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="供应商" VerticalAlignment="Center"/>
                <TextBox Width="110" Text="{Binding Gyname, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="�库日期" VerticalAlignment="Center"/>
                <DatePicker Width="110" SelectedDate="{Binding InDateFrom}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBlock Text="~" VerticalAlignment="Center"/>
                <DatePicker Width="110" SelectedDate="{Binding InDateTo}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <Button Content="查询" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 操作条 -->
        <Border DockPanel.Dock="Top" Padding="0,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="添加到退货车 F1" Command="{Binding AddToCartCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="删除退货行" Command="{Binding RemoveCartCommand}" Padding="14,3" Margin="0,0,8,0"/>
                <Button Content="�空退货车" Command="{Binding ClearCartCommand}" Padding="14,3" Margin="0,0,16,0"/>
                <TextBlock Text="退款方式" VerticalAlignment="Center"/>
                <ComboBox Width="110" ItemsSource="{Binding FkfsOptions}" SelectedItem="{Binding SelectedFkfs}"
                          VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="退货原因" VerticalAlignment="Center"/>
                <ComboBox Width="110" ItemsSource="{Binding ReasonOptions}" SelectedItem="{Binding SelectedReason}"
                          VerticalAlignment="Center" Margin="4,0,16,0"/>
                <Button Content="确认退货" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCommand}" Padding="16,3"/>
            </StackPanel>
        </Border>

        <!-- 合计/消息条 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="外币价合计：" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalIprj, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="   进价合计：" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalIprc, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Message}" Foreground="#C0392B" VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 上：可退流水（ised） / 下：退货车（c_th） -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="�件编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="原进库数" Binding="{Binding Oamount}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="可退数" Binding="{Binding Amount}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="当前库存" Binding="{Binding Kshu}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="�库单号" Binding="{Binding Cno}" IsReadOnly="True" Width="95"/>
                    <DataGridTextColumn Header="库号" Binding="{Binding Depotno}" IsReadOnly="True" Width="50"/>
                    <DataGridTextColumn Header="仓位" Binding="{Binding Posi}" IsReadOnly="True" Width="55"/>
                    <DataGridTextColumn Header="进价" Binding="{Binding Iprc}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="�库日期" Binding="{Binding Indate, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="供应商" Binding="{Binding Gyname}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" IsReadOnly="True" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCart}"
                      AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="�件编号" Binding="{Binding Nno}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Na1}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="退库数" Binding="{Binding Amount, UpdateSourceTrigger=LostFocus}" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="外币价" Binding="{Binding Iprj, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding DataContext.PriceLocked, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="进价" Binding="{Binding Iprc, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding DataContext.PriceLocked, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="60" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="库号" Binding="{Binding Depotno}" Width="55"/>
                    <DataGridTextColumn Header="仓位" Binding="{Binding Posi}" Width="55"/>
                    <DataGridTextColumn Header="原进库数" Binding="{Binding Oamount}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="当前库存" Binding="{Binding Kshu}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource NumCellRight}"/>
                    <DataGridTextColumn Header="原单号" Binding="{Binding Cno}" IsReadOnly="True" Width="95"/>
                    <DataGridTextColumn Header="厂牌" Binding="{Binding Cp}" IsReadOnly="True" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
