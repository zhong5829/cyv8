<UserControl x:Class="QPGL.Desktop.Views.FinBasicControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="录入1" VerticalAlignment="Center"/>
                <TextBox Width="120" Text="{Binding Input1, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="录入2" VerticalAlignment="Center"/>
                <TextBox Width="120" Text="{Binding Input2, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>
        <TabControl>
            <TabItem Header="币别（finmoney）">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="添加币别" Command="{Binding AddCurrencyCommand}"/>
                        <Button Content="删除最后一行" Command="{Binding DeleteCurrencyCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Currencies}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="代码" Binding="{Binding Item1}" Width="100"/>
                            <DataGridTextColumn Header="币名" Binding="{Binding Item2}" Width="*"/>
                            <DataGridTextColumn Header="汇率" Binding="{Binding Item3, StringFormat=N4}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="凭证摘要（finsumary）">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="添加摘要" Command="{Binding AddSumaryCommand}"/>
                        <Button Content="删除最后一行" Command="{Binding DeleteSumaryCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Sumaries}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Item1}" Width="60"/>
                            <DataGridTextColumn Header="摘要" Binding="{Binding Item2}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="核算项目（finset）">
                <DataGrid ItemsSource="{Binding FinSets}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Item1}" Width="60"/>
                        <DataGridTextColumn Header="类别" Binding="{Binding Item2}" Width="120"/>
                        <DataGridTextColumn Header="内容" Binding="{Binding Item3}" Width="*"/>
                        <DataGridTextColumn Header="次序" Binding="{Binding Item4}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="员工资料（finempl）">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="添加员工" Command="{Binding AddEmployeeCommand}"/>
                        <Button Content="删除最后一行" Command="{Binding DeleteEmployeeCommand}" Margin="8,0,0,0"
                                ToolTip="打开页面时自动清理空行（fr_finEmplf Load 契约）"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Employees}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="代码" Binding="{Binding Item1}" Width="100"/>
                            <DataGridTextColumn Header="姓名" Binding="{Binding Item2}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="现金银行（finrecout）">
                <DataGrid ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Item1}" Width="50"/>
                        <DataGridTextColumn Header="帐目名称" Binding="{Binding Item2}" Width="*"/>
                        <DataGridTextColumn Header="类" Binding="{Binding Item3}" Width="40"/>
                        <DataGridTextColumn Header="科目" Binding="{Binding Item4}" Width="110"/>
                        <DataGridTextColumn Header="科目名" Binding="{Binding Item5}" Width="160"/>
                        <DataGridTextColumn Header="帐号" Binding="{Binding Item6}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
